    <script>
      (function () {
        if (location.pathname.indexOf('/collections/engagement-rings') > -1) return;
        if (sessionStorage.getItem('wdd_engagement_http_warmed_v1')) return;

        var COLLECTION_HANDLE = 'engagement-rings';
        var SKU_VIEW = 'wdd-sku-en-json';

        function getHandles(page) {
          return fetch('/collections/' + COLLECTION_HANDLE + '/products.json?limit=250&page=' + page, {
            credentials: 'same-origin',
            cache: 'force-cache',
          })
            .then(function (r) {
              return r.ok ? r.json() : { products: [] };
            })
            .then(function (d) {
              return (d.products || []).map(function (p) {
                return p.handle;
              });
            })
            .catch(function () {
              return [];
            });
        }

        function warmSku(handles) {
          var queue = handles.filter(Boolean);

          function batch() {
            var items = queue.splice(0, 80);

            items.forEach(function (handle) {
              fetch('/products/' + handle + '?view=' + encodeURIComponent(SKU_VIEW), {
                credentials: 'same-origin',
                cache: 'force-cache',
              }).catch(function () {});
            });

            if (queue.length) {
              setTimeout(batch, 50);
            } else {
              sessionStorage.setItem('wdd_engagement_http_warmed_v1', '1');
            }
          }

          batch();
        }

        setTimeout(function () {
          Promise.all([getHandles(1), getHandles(2)]).then(function (pages) {
            warmSku([].concat.apply([], pages));
          });
        }, 50);
      })();
    </script>
