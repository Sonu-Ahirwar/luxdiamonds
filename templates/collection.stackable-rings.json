                "width": 20
              },
              "blocks": {
                "text_EgFUCd": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Vintage jewelry refers to pieces that are at least 20-30 years old, often characterized by unique styles and craftsmanship from a specific era. Unlike antique jewelry, which is over 100 years old, vintage items are typically from the 20th century.</p>",
                    "width": "100%",
