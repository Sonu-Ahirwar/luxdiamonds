                  },
                  "blocks": {
                    "text_Ph7Ch6": {
                      "type": "text",
                      "settings": {
                        "text": "<p>We want you to love everything about your jewelry so if something isn’t just right, we give you 60 days to return your jewelry, no questions asked.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
