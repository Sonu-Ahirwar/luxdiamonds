              },
              "blocks": {
                "accordion_row_K3q73D": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "How long does the process take?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 12
                  },
                  "blocks": {
                    "text_e3BV8A": {
                      "type": "text",
                      "settings": {
                        "text": "<p>A custom design can take as little as 16 days. Depending on the intricacy and detail of your piece, the process can take longer. But do not worry. We will work as fast as you would like with as much detail as possible to get it just right.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
