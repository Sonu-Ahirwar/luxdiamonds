                    }
                  },
                  "block_order": [
                    "text_e3BV8A"
                  ]
                },
                "accordion_row_cAgDcw": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Is custom jewelry more expensive?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_FbhMTT": {
                      "type": "text",
                      "settings": {
                        "text": "<p>No! At Wedding Day Diamonds, the process is completely FREE and it does not matter that its being custom made just for you. You will not see a significant difference in a custom piece you create compared to a style you may see in our showcases. </p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "color": "var(--color-foreground)",
                        "background": true,
                        "background_color": "#ffffff",
                        "corner_radius": 0,
                        "padding-block-start": 50,
                        "padding-block-end": 50,
                        "padding-inline-start": 60,
                        "padding-inline-end": 60
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_FbhMTT"
                  ]
                },
                "accordion_row_8NYwFc": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Is my custom design covered under the Wedding Day Diamonds Warranty?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_AcHnqn": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Of course! All jewelry purchased from Wedding Day Diamonds is covered by our FREE lifetime warranty. We make sure your custom piece is up to our standards of quality just like all other jewelry we carry in our stores. We want you to be 100% happy with your piece and we will take care of it for a lifetime.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
