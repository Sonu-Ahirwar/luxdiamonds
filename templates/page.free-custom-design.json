                  "block_order": [
                    "text_AcHnqn"
                  ]
                },
                "accordion_row_LAg3pr": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "What if I don't like the piece I create?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_tTce6H": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Your jewelry is covered under our Perfect Ring Promise! If you do not like the piece of jewelry you created, you have 60 days to return it and up to 365 days to exchange it once for something of equal or greater value. <a href=\"/pages/customer-service\" title=\"Customer Service\">Learn More !</a></p>",
                        "width": "fit-content",
