    "promise_split_section_Ch99kV": {
      "type": "promise-split-section",
      "blocks": {
        "feature_T4n6MG": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/promise1.png",
            "text": "<p>If you don't completely love your custom ring, you have <em><strong>sixty days to return it</strong></em>, no questions asked. <em><strong>Within 365 days</strong></em>, you can exchange your custom ring by putting its full value towards any other ring.</p>"
          }
        },
        "feature_eDaKxh": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/promise2_49905054-257f-486a-a1e7-29ffa97c1267.png",
            "text": "<p>We're able to make this promise because we have an industry leading lifetime warranty, unequaled quality control, and most important, an absolute commitment to our clients. If tragedy strikes, we will repair, replace, or remake your custom ring free-of-charge.</p>"
          }
        },
        "feature_WPHTgU": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/promise3_3bc1159c-3afb-4053-8cb6-894529e0a476.png",
            "text": "<p>With our Perfect Ring Promise, you and your jewelry are protected in every way.</p>"
          }
        }
      },
