                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_FKxdmK": {
                  "type": "text",
                  "settings": {
                    "text": "<p>A solitaire engagement ring features a single, prominent gemstone, usually a diamond. It's a classic and refined choice, highlighting the stone's beauty and symbolizing your love's simplicity and purity.</p>",
