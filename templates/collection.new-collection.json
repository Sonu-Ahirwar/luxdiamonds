            "accordion_row_4Gmza3": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What makes Wedding Day Diamonds' engagement rings unique?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_LfazHg": {
                  "type": "text",
                  "settings": {
                    "text": "<p>The engagement rings at Wedding Day Diamonds are distinguished by their elegance and elevated craftsmanship. Each ring is thoughtfully designed to symbolize your unique bond and commitment, making it a cherished piece to commemorate your forever journey.</p>",
