              "blocks": {
                "text_jMJXxV": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Absolutely! We offer extensive customization options, including selecting the metal type, and engraving personal messages. This allows you to create a unique ring that truly reflects your personal style and the special significance of your wedding band.</p>",
                    "width": "100%",
                    "max_width": "none",
