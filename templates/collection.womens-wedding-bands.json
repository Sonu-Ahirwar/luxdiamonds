            },
            "accordion_row_4Gmza3": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What is an eternity band?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_LfazHg": {
                  "type": "text",
                  "settings": {
                    "text": "<p>An eternity band is a ring adorned with a continuous line of gemstones, typically diamonds, encircling the band. This design symbolizes eternal love and commitment, making it a popular choice for wedding bands and anniversary gifts, representing undying devotion.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "custom",
