            "accordion_row_zGaB6G": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Can I find wedding bands that match my engagement ring?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_U7yYp8": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes, we provide a variety of bands designed to complement and match engagement rings. Options like curved and stackable bands are ideal for creating a cohesive and harmonious look, ensuring your wedding and engagement rings are perfectly paired.</p>",
                    "width": "100%",
