              ]
            },
            "accordion_row_CRcFPm": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "6. Can fashion rings include gemstones?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_jMJXxV": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Yes, many fashion rings feature gemstones such as sapphires, rubies, or amethysts. These rings offer a colorful, eye-catching option to complement your personal style.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
