              "block_order": [
                "text_U7yYp8"
              ]
            },
            "accordion_row_4Gmza3": {
              "type": "_accordion-row",
              "settings": {
                "heading": "3. Can I wear a fashion ring every day?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_LfazHg": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes, many fashion rings are designed for everyday wear. However, it’s best to remove them during heavy activities or when working with harsh chemicals to prevent damage or scratches.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "custom",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
