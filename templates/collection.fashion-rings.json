              "block_order": [
                "text_LfazHg"
              ]
            },
            "accordion_row_keYfk8": {
              "type": "_accordion-row",
              "settings": {
                "heading": "4. How do I care for my gold and platinum fashion rings?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_jDbKL3": {
                  "type": "text",
                  "settings": {
                    "text": "<p>To keep your gold and platinum rings looking their best, clean them regularly with a soft cloth and mild soap. Avoid exposing them to chemicals and store them in a jewelry box when not in use.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "custom",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
