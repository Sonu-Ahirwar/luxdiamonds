              "block_order": [
                "text_r9WyPJ"
              ]
            },
            "accordion_row_zGaB6G": {
              "type": "_accordion-row",
              "settings": {
                "heading": "2. What metals are commonly used for fashion rings?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_U7yYp8": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Fashion rings are often crafted from White Gold, Yellow Gold, Rose Gold, and Platinum. These metals offer durability, luxury, and a range of styles to match any look.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "custom",
