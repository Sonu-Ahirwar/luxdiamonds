          "blocks": {
            "accordion_row_PpFM4J": {
              "type": "_accordion-row",
              "settings": {
                "heading": "1. What is a fashion ring?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_r9WyPJ": {
                  "type": "text",
                  "settings": {
                    "text": "<p>A fashion ring is a piece of jewelry worn for style rather than symbolic reasons, like an engagement or wedding ring. They come in various designs, perfect for daily wear or adding flair to special occasions.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "custom",
                    "font": "var(--font-body--family)",
