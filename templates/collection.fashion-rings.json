              "block_order": [
                "text_jDbKL3"
              ]
            },
            "accordion_row_JzWmTG": {
              "type": "_accordion-row",
              "settings": {
                "heading": "5. What’s the difference between fashion rings and fine rings?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_mmN79y": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Fashion rings are primarily worn for style and may feature more creative or trendy designs. Fine rings, like engagement or wedding rings, often have symbolic meanings and are usually made with precious stones like diamonds.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
