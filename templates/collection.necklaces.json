                "width": 20
              },
              "blocks": {
                "text_PUyyk6": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>For a simple, elegant look, a classic chain or pendant works well with most outfits. For bolder looks, statement necklaces can add drama to your outfit, especially for evening wear or special occasions.</p>",
                    "width": "100%",
                    "max_width": "none",
