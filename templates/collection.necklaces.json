            "accordion_row_MyRLLD": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "8. Are gold necklaces hypoallergenic?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_EgFUCd": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>High-quality gold necklaces, particularly those made from 14K or higher gold, are typically hypoallergenic. However, those with sensitive skin should avoid gold-plated jewelry, which can sometimes contain allergenic metals.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
