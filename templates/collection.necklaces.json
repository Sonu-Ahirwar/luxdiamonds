            "accordion_row_UHqe6Y": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "9. What is the difference between White Gold and Silver necklaces?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_nXe7cp": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>White Gold is an alloy of gold mixed with other metals and coated with rhodium, offering more durability and resistance to tarnish than Silver. Silver is softer and may require more frequent polishing, but offers an affordable alternative.</p>",
                    "width": "100%",
                    "max_width": "none",
