              },
              "blocks": {
                "text_LfazHg": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Start by layering new diamond necklaces with your classic pendants or adding a modern stackable ring to your daily jewelry rotation. Mixing metals, such as pairing yellow gold with white gold, is an excellent way to refresh your look with our newest jewelry arrivals.</p>",
                    "width": "100%",
