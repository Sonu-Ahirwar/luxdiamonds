              "blocks": {
                "accordion_row_atNQtX": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "How long do repairs take?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 12
                  },
                  "blocks": {
                    "text_RVk6e9": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Most repairs take one week to complete. Your repair will go into a queue based on the day you drop it off at one of our stores. If you need something done quickly, please give our stores a call or submit an appointment request above.</p>",
                        "width": "100%",
                        "max_width": "none",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
