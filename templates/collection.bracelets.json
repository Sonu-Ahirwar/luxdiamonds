              "block_order": [
                "text_jMJXxV"
              ]
            },
            "accordion_row_ERnfMG": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "6. Are gold bracelets hypoallergenic?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_PUyyk6": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>High-quality gold bracelets made from 14K or higher gold are generally hypoallergenic. If you have sensitive skin, it’s best to avoid gold-plated pieces, which may contain allergenic metals.</p>",
                    "width": "100%",
                    "max_width": "none",
