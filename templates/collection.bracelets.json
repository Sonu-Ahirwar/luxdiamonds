            },
            "accordion_row_CRcFPm": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "5. How do I choose the right size bracelet?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_jMJXxV": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>To find your bracelet size, measure your wrist and add about half an inch for a comfortable fit. Adjustable bracelets, like bangles or chain styles with extenders, offer more flexibility in sizing.</p>",
                    "width": "100%",
                    "max_width": "none",
