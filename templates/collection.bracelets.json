          "blocks": {
            "accordion_row_PpFM4J": {
              "type": "_accordion-row",
              "settings": {
                "heading": "1. What types of bracelets are most popular?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_r9WyPJ": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Popular types of bracelets include chain bracelets, bangles, cuffs, and charm bracelets. Each offers a different style, from simple and elegant chains to bold, statement-making bangles and cuffs.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "custom",
