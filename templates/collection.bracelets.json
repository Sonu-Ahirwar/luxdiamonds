              "block_order": [
                "text_r9WyPJ"
              ]
            },
            "accordion_row_4Gmza3": {
              "type": "_accordion-row",
              "settings": {
                "heading": "2. What metal is best for bracelets?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_LfazHg": {
                  "type": "text",
                  "settings": {
                    "text": "<p>White Gold, Yellow Gold, Rose Gold, and Silver are all excellent choices for bracelets. Gold provides luxury and durability, while Silver offers a sleek, modern look. The best metal depends on your personal style and preference.</p>",
                    "width": "100%",
                    "max_width": "none",
