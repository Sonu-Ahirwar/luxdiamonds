              "block_order": [
                "text_LfazHg"
              ]
            },
            "accordion_row_keYfk8": {
              "type": "_accordion-row",
              "settings": {
                "heading": "3. How do I care for my gold and silver bracelets?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_jDbKL3": {
                  "type": "text",
                  "settings": {
                    "text": "<p>To maintain the shine of your gold and silver bracelets, clean them regularly with a soft cloth and mild soap. Avoid exposing them to harsh chemicals, and store them in a dry, cool place to prevent tarnishing.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "custom",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
