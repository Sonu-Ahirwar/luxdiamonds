              ]
            },
            "accordion_row_JzWmTG": {
              "type": "_accordion-row",
              "settings": {
                "heading": "4. Can bracelets be worn every day?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_mmN79y": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes, many bracelets, especially chain or bangle styles, are designed for everyday wear. Just be mindful to remove them during heavy activities to prevent scratching or damage.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
