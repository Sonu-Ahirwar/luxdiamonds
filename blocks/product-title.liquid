{% if closest.product == blank %}
  {% assign text = 'placeholders.product_title' | t %}
  {% assign product_title = '<h4>' | append: text | append: '</h4>' %}
  {% render 'text', fallback_text: product_title, block: block %}
{% elsif closest.product != blank %}
  {% assign product_title = '<p>' | append: closest.product.title | append: '</p>' %}

  {%- comment -%}
    Link parameter ?metal_color=&center_stone_shape= same as pehle
  {%- endcomment -%}  
  {% liquid
    assign prod = closest.product
    assign mf = prod.metafields.custom.custom_all_skus
    assign parent_handle_mf = prod.metafields.custom.parent_handle.value | default: ''
    if mf == blank and parent_handle_mf != ''
      assign parent_prod = all_products[parent_handle_mf]
      if parent_prod != blank
        assign mf = parent_prod.metafields.custom.custom_all_skus
        if mf == blank
          assign mf = parent_prod.metafields.custom.all_skus
        endif
      endif
    endif
    if mf == blank
      assign mf = prod.metafields.custom.all_skus
    endif
  %}
  {% assign filterTrue = false %}
  {% assign ShapeValue = '' %}
  {% assign MetalValue = '' %}
  {% for filter in collection.filters %}
  {% if filter.param_name contains 'filter.p.m.custom.' %}
    {% if filter.active_values.size > 0 %}
      {% if filter.label == 'Shape' %}
        {% assign filterTrue = true %}
        {% assign ShapeValue = filter.active_values[0].label %}
     {% endif %}
      {% if filter.label == 'Metal' %}
        {% assign filterTrue = true %}
        {% for value in filter.active_values %}
          {% assign MetalValue = filter.active_values[0].label %}
        {% endfor %}        
      {% endif %}
      {% if filter.label == 'gemstone' %}
        {% assign filterTrue = true %}
        {% for value in filter.active_values %}
          {% assign gemValue = filter.active_values[0].label %}
        {% endfor %}        
      {% endif %}
    {% endif %}
  {% endif %}
{% endfor %}
{% if MetalValue == '' %}
  {% assign MetalValue = prod.metafields.custom.active_metal_on_plp.value | escape  %}
{% endif %}
  
{% if ShapeValue == '' %}
  {% assign ShapeValue = prod.metafields.custom.active_shape_on_plp.value | escape  %}
{% endif %}

  {% if current_tags != blank %}
    {% for skuData in mf.value %}
      {% if current_tags contains skuData.metal_color  or current_tags contains skuData.center_stone_shape %}
        {% assign linkParameter = '?new_url=' | append: skuData.url_key %}
        {%  break %}
      {% endif %}
    {% endfor %}
  {% else %}
    {% for skuDatadate in prod.metafields.custom.all_sku_plp.value  %}      
    {% assign default_name = prod.metafields.custom.pdp_title.value | handleize %}
    {% assign skudefault = skuDatadate.name | handleize %}
    
    {% if MetalValue contains skuDatadate.metal_color  and  ShapeValue contains skuDatadate.center_stone_shape and skudefault == default_name %}
          {% assign skuData = skuDatadate %}
          {%  break %}
    {% comment %} {% elsif skudefault == default_name and MetalValue contains skuDatadate.metal_color %}
        {% assign skuData = skuDatadate %}
      {{skuDatadate.url_key }}****<br>
      {%  break %} {% endcomment %}
    {% endif %}
    {% endfor %}
    
    {% assign linkParameter = '?new_url=' | append: skuData.url_key %}
  {% endif %}
{% comment %} {{linkParameter }}==== {% endcomment %}
  {%- comment -%}
    ✅ Yahan se NEW: parent_handle ke base par URL override
  {%- endcomment -%}
  {%- liquid
    assign parent_handle_mf = closest.product.metafields.custom.parent_handle

    if parent_handle_mf == blank
      assign parent_handle_mf = ''
    endif

    if parent_handle_mf != ''
      # PLP clone → parent PDP pe bhejna
      assign base_card_url = routes.root_url | append: 'products/' | append: parent_handle_mf
    else
      # Normal product → theme ka default product-card-variant-url
      capture default_card_url
        render 'product-card-variant-url', product: closest.product
      endcapture
      assign base_card_url = default_card_url | strip
    endif
  -%}

  <a
    class="contents user-select-text card_productTitle bbbbbbbb"
    ref="productTitleLink"
    href="{{ base_card_url | split: '?variant' | first }}{{ linkParameter }}"
  >
    {% if template contains 'collection' and closest.product.metafields.custom.pdp_title.value != blank %}
      {% assign product_title = '<p>' | append: closest.product.metafields.custom.pdp_title.value | append: '</p>' %}
    {% endif %}
    {{  closest.product.metafields.custom.pdp_title.value }}
  </a>
{% endif %}

