{%- assign block_settings = block.settings -%}

{% capture title %}
  {% content_for 'block', id: 'heading', type: '_heading', text: article.title %}
{% endcapture %}

{% capture details %}
  {% content_for 'block',
    id: 'blog-post-details',
    type: '_blog-post-info-text',
    alignment: block_settings.alignment,
    article: article
  %}
{% endcapture %}

{% capture description %}
  {% content_for 'block', id: 'content', type: '_blog-post-description', article: article, show_read_more: true %}
{% endcapture %}
<div class="blog-post-card {% if article.image or content_image != blank %}has-image{% endif %}" style="--text-align: {{ block_settings.alignment }}">
  
{% assign content_image = '' %}

{% if article.content contains '<img' %}
  {% assign parts = article.content | split: '<img' %}
  {% assign first_img = parts[1] | split: 'src="' %}
  {% assign img_url = first_img[1] | split: '"' | first %}
  {% assign content_image = img_url %}
{% endif %}

<div class="blog-post-card__image-container">
  <a href="{{ article.url }}">

    {%- if article.image -%}
      {% content_for 'block', id: 'image', type: '_blog-post-image', image: article.image %}

    {%- elsif content_image != blank -%}
      <img 
        src="{{ content_image }}"
        alt="{{ article.title }}"
        loading="lazy"
      >

    {%- endif -%}

  </a>
</div>

  <div class="blog-post-card__content">
    <a href="{{ article.url }}">{{ title }}</a>
      {% comment %} {{ details }} {% endcomment %}

  <div class="share-wrapper">
    <button class="share-btn" data-url="{{ article.url }}">
      &#8942;
    </button>
    <div class="share-dropdown">
      <button class="open-popup">
        <svg xmlns="http://www.w3.org/2000/svg" width="19" viewBox="0 0 19 19" role="img" class="blog-icon-fill"><path d="M16.9410444,8.39109677 C17.0195644,8.46818967 17.0195644,8.59371274 16.9410444,8.67080564 L11.9026789,13.6176004 C11.7063789,13.8103326 11.3872657,13.8103326 11.1909657,13.6176004 C11.096339,13.5246935 11.0429857,13.3991705 11.0429857,13.2677172 L11.0429857,11.0013834 C7.27402658,11.0013834 4.38690723,12.7339971 2.38263435,16.1972475 C2.27794104,16.3781194 1.99204777,16.3049799 2.0001011,16.0964337 C2.24975438,10.0357454 5.2637137,6.69011101 11.0429857,6.05953059 L11.0429857,3.79418524 C11.0429857,3.52040659 11.268479,3.29999995 11.5463189,3.29999995 C11.6802056,3.29999995 11.8080522,3.35139522 11.9026789,3.44430206 L16.9410444,8.39109677 Z M3.43409745,13.1243046 C5.43837033,11.0576217 7.98624309,10.0139024 11.0434891,10.0139024 L12.0501555,10.0139024 L12.0501555,12.0746551 L15.6600614,8.53035818 L12.0501555,4.98704968 L12.0501555,6.94501178 L11.1542224,7.0418721 C6.94635665,7.50146442 4.39949056,9.49994971 3.43409745,13.1243046 Z"></path></svg>
      Share Post
    </button>
    </div>
  </div>

    <div class="content-blog" style="display: none;">
      {% assign words = article.content | strip_html | split: ' ' | size %}
{% assign read_time = words | divided_by: 150 | ceil %}


    <p>{{ blog.title }}</p>
     {% comment %} <p>{{ article.published_at | date: "%b %d, %Y " }}<span>{{ ' • '| append:read_time | replace : 0 , 1 }} min read</span></p> {% endcomment %}
</div>
    {{ description }}
  </div>
</div>

{% stylesheet %}

.blog-post-card {
  display: flex;
  flex-direction: column;
  text-align: var(--text-align);
  width: 100%;
  height: 100%;
  position: relative;
}

.blog-post-card__content {
  padding-block-start: 0.4rem;
  display: flex;
  flex-direction: column;
  padding-inline-start: var(--columns-gap);
  width: 100%;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column-reverse;
  justify-content: space-between;
  z-index: 3;
  padding: 25px;
}

.blog-post-card {
  position: relative;
  height: 100%;
}

.blog-post-item {
  display: flex;
}


.blog-post-card__image-container {
  aspect-ratio: 1 / 1;
  position: relative;
}

.blog-post-card__content {
  overflow: hidden;
}

.blog-post-item .blog-post-card__image-container,
.blog-post-item .blog-post-card__content {
  width: 100%;
}

.blog-post-item:first-child .blog-post-card {
  flex-direction: row;
}

@media screen and (max-width: 749px) {
  .blog-post-item:first-child .blog-post-card {
    flex-direction: column;
  }
}

.blog-post-item:first-child .blog-post-card__image-container {
  width: 100%;
  position: relative;
}

@media screen and (max-width: 749px) {
  .blog-post-item:first-child .blog-post-card__image-container {
    width: 100%;
  }
}

.blog-post-card__image-container {
  height: 100%;
  aspect-ratio: 1 / 1;
  position: relative;
  overflow: hidden;
}

.blog-post-card__image-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.blog-post-item {
  display: flex;
}

.blog-post-card__content p {
  font-size: 12px;
  color: #fff;
  margin: 0;
}

.blog-post-card__content a {
  display: block;
  text-wrap: pretty;
  text-decoration: none;
  padding-block-start: 0.75rem;
  color: #fff;
  white-space: normal;
  word-break: break-word;
}

.content-blog {
  writing-mode: horizontal-tb;
}

time {
  color: #fff;
}

.blog-post-card:after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1;
  pointer-events: none;
}

.blog-post-item:hover .blog-post-card__content a {
  color: #646fb0;
}

.blog-post-card__content a:hover [style*='--color: var(--color-foreground-heading)'] {
  color: rgb(var(--color-foreground-heading-rgb) / var(--opacity-subdued-text));
}

.blog-post-card__content a:hover [style*='--color: var(--color-foreground)'] {
  color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
}

@media screen and (max-width: 749px) {
  .blog-post-card__content {
    padding: 20px;
    width: 100%;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "settings": [
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    }
  ]
}
{% endschema %}



<div id="share-popup" class="share-popup">
  <div class="share-box">   
    <button class="share-close">&times;</button>
    <h3>Share Post</h3>
   <div class="share-icons">
      <a id="fb-share" target="_blank" class="icon fb">f</a>
      <a id="tw-share" target="_blank" class="icon tw">X</a>
      <a id="ln-share" target="_blank" class="icon ln">in</a>
      <a id="copy-link" class="icon copy">🔗</a>
    </div>
  </div>
</div>

<style>
  /* SHARE BUTTON */
/* WRAPPER */
.share-wrapper {
  position: absolute;
  top: 20px;
  right: 12px;
  z-index: 10;
}

/* 3 DOTS */
.share-btn {
  background: transparent;
  border: none;
  color: #fff;
  font-size: 22px;
  cursor: pointer;
  text-shadow: 0 0 6px rgba(0,0,0,0.6);
}

/* DROPDOWN TOOLTIP */
.share-dropdown {
  position: absolute;
  top: 30px;
  right: 0;
  background: #eee;
  padding: 10px 16px;
  display: none;
  min-width: 150px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}

/* BUTTON INSIDE */
.share-dropdown button {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 14px;
  gap: 10px;
    align-items: center;
    display: flex;
    padding: 10px 9px;
}

/* SHOW */
.share-dropdown.active {
  display: block;
}
/* TOOLTIP */
.share-tooltip {
  position: absolute;
  top: -25px;
  right: 0;
  background: black;
  color: #fff;
  font-size: 10px;
  padding: 4px 6px;
  border-radius: 4px;
  display: none;
}

.share-wrapper:hover .share-tooltip {
  display: block;
}

/* BACKDROP */
.share-popup {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.65);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}
.share-popup {
  display: none;
}

.share-popup.active {
  display: flex;
}

/* MODAL BOX */
.share-box {
  background: #f5f5f5;
  padding: 40px 30px;
  border-radius: 6px;
  text-align: center;
  position: relative;
  width: 420px;
  max-width: 90%;
}

/* TITLE */
.share-box h3 {
  margin-bottom: 25px;
  font-size: 20px;
  font-weight: 600;
}

/* CLOSE BUTTON (TOP RIGHT) */
.share-close {
  position: absolute;
  top: 12px;
  right: 15px;
  font-size: 22px;
  border: none;
  background: transparent;
  cursor: pointer;
}

/* ICON ROW */
.share-icons {
  display: flex;
  justify-content: center;
  gap: 20px;
}

/* ROUND ICONS */
.icon {
  width: 55px;
  height: 55px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 18px;
  text-decoration: none;
  transition: 0.3s;
}

/* COLORS (MATCH SCREENSHOT) */
.icon.fb { background: #3b5998; }
.icon.tw { background: #55acee; }
.icon.ln { background: #0077b5; }
.icon.copy { background: #333; }

/* HOVER EFFECT */
.icon:hover {
  transform: scale(1.1);
}
</style>
<script>
document.addEventListener("DOMContentLoaded", function() {

  const popup = document.getElementById('share-popup');
  let currentUrl = '';
  document.addEventListener('click', function(e) {
    if (e.target.closest('.share-btn')) {
      e.stopPropagation();

      const btn = e.target.closest('.share-btn');

      document.querySelectorAll('.share-dropdown').forEach(d => d.classList.remove('active'));

      const dropdown = btn.parentElement.querySelector('.share-dropdown');
      dropdown.classList.add('active');

      currentUrl = window.location.origin + btn.dataset.url;
      return;
    }

    if (e.target.closest('.open-popup')) {
      e.stopPropagation();

      popup.classList.add('active');

      document.getElementById('fb-share').href =
        `https://www.facebook.com/sharer/sharer.php?u=${currentUrl}`;

      document.getElementById('tw-share').href =
        `https://twitter.com/intent/tweet?url=${currentUrl}`;

      document.getElementById('ln-share').href =
        `https://www.linkedin.com/sharing/share-offsite/?url=${currentUrl}`;

      document.getElementById('copy-link').onclick = () => {
        navigator.clipboard.writeText(currentUrl);
      };

      return;
    }

    document.querySelectorAll('.share-dropdown').forEach(d => d.classList.remove('active'));

    if (popup.classList.contains('active')) {
      popup.classList.remove('active');
    }
  });

  document.querySelector('.share-close').addEventListener('click', function(e) {
    e.stopPropagation();
    popup.classList.remove('active');
  });

});
</script>