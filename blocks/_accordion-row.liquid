
{% assign block_settings = block.settings %}
{%- liquid  
  assign fields = 'custom_all_skus,custom_all_skus_1,custom_all_skus_2,custom_all_skus_3,custom_all_skus_4,custom_all_skus_5' | split: ','
  assign mf_items = '' | split: ','

  for f in fields
    assign m = product.metafields.custom[f]
    if m != blank and m.value != blank
      assign mf_items = mf_items | concat: m.value
    endif
  endfor

  assign mf = mf_items
  if mf != blank
   assign mf = mf
  endif
-%}
{% if block_settings.heading contains "FREE GEMSTONE WARRANTY" and template contains 'product' %}
  {% assign hideGemStoneAccordian = true %}
  {% if mf[0].category == 'New Arrivals Engagement Rings' %}
      {% assign hideGemStoneAccordian = false %}
  {% endif %}
{% endif %}
{% unless hideGemStoneAccordian %}
  <accordion-custom data-block-id="{{ block.id }}"
  {% if block_settings.open_by_default %}
    open-by-default-on-desktop
    open-by-default-on-mobile
  {% endif %}
>
  <details
    class="details"
    data-testid="accordion-details"
    {{ block.shopify_attributes }}
  >
    <summary class="details__header">
      {% render 'icon-or-image',
        icon: block_settings.icon,
        image_upload: block_settings.image_upload,
        width: block_settings.width,
        class_name: 'details__icon'
      %}
      {{ block_settings.heading }}
      <span class="svg-wrapper icon-caret icon-animated">
        {% if template.name == 'product' %}
          {{- 'icon-caret.svg' | inline_asset_content -}}
        {% else page.title == 'Custom Design'%}
          {{- 'icon-caret.svg' | inline_asset_content -}}
        {% else %}
          <svg fill="#395754" width="11px" height="11px" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M11.178 19.569a.998.998 0 0 0 1.644 0l9-13A.999.999 0 0 0 21 5H3a1.002 1.002 0 0 0-.822 1.569l9 13z"></path></g></svg>
        {% endif %}
      </span>
      <span class="svg-wrapper icon-plus">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div class="details-content">
      {% content_for 'blocks' %}
    </div>
  </details>
</accordion-custom>
{% endunless %}


{% stylesheet %}
  .details__icon {
    height: auto;
    margin-inline-end: var(--margin-xs);
  }
{% endstylesheet %}

