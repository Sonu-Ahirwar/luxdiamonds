{% doc %}
  @prompt
    Generate a heading block same but add image option and image is showing before the heading text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-heading-with-image-{{ ai_gen_id }} {
    display: flex;
    align-items: {{ block.settings.alignment }};
    gap: {{ block.settings.spacing }}px;
    flex-direction: {{ block.settings.layout }};
    justify-content: {{ block.settings.justify }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
  }

  {% comment %} .ai-heading-with-image__image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
  } {% endcomment %}

  .ai-heading-with-image__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-heading-with-image__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-heading-with-image__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-heading-with-image__text-wrapper-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-heading-with-image__heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    text-align: {{ block.settings.text_align }};
    text-transform: {{ block.settings.text_transform }};
  }

  @media screen and (max-width: 749px) {
    .ai-heading-with-image-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.mobile_layout }};
    }

    .ai-heading-with-image__image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_image_width }}px;
      height: {{ block.settings.mobile_image_height }}px;
    }

    .ai-heading-with-image__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<div class="ai-heading-with-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.image %}
    <div class="heading__image-wrapper ai-heading-with-image__image-wrapper-{{ ai_gen_id }}">
      <img
        src="{{ block.settings.image | image_url: width: 400 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-heading-with-image__image-{{ ai_gen_id }}"
      >
    </div>
  {% elsif block.settings.show_placeholder %}
    <div class="heading__image-wrapper ai-heading-with-image__image-wrapper-{{ ai_gen_id }}">
      <div class="ai-heading-with-image__image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    </div>
  {% endif %}

  <div class="ai-heading-with-image__text-wrapper-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="heading_image_text ai-heading-with-image__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}
  </div>
</div>

{% schema %}
{
