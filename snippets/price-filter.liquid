  pointer-events: auto;
  width: 20px;
  height: 20px;
  background: #fff;
  border: 2px solid #6f7f7b;
  border-radius: 50%;
  -webkit-appearance: none;
  margin-top: -7px;
  z-index: 3;
  position: relative;
}

.price-field input[type="range"]::-moz-range-thumb {
  pointer-events: auto;
  width: 20px;
  height: 20px;
  background: #fff;
  border: 2px solid #6f7f7b;
  border-radius: 50%;
  z-index: 3;
}

/* ===== TOOLTIP ===== */
.price-wrap {
  position: relative;
  margin-top: -50px;
}

.price-wrap input {
  background: #6f7f7b;
  color: #fff;
  border: none;
  border-radius: 6px;
  /* padding: 4px 8px; */
  font-size: 12px;
  width: auto;
  text-align: center;
  pointer-events: none;
  width: 100%;
}

/* Hide labels ($) visually if not needed */
.price-wrap label {
  display: none;
}

/* Tooltip containers */
.price-wrap-1, .price-wrap-2 {
    position: absolute;
    top: -35px;
    transform: translate(-50%);
    white-space: nowrap;
    background-color: rgb(114, 128, 128);
    color: rgb(255, 255, 255);
    font-size: 0.75rem;
    border-radius: 6px;
    box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 6px;
    width: 50px;
}


/* Base reset */
.price-field input[type="range"] {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  background: transparent;
}

/* Chrome, Edge, Safari */
.price-field input[type="range"]::-webkit-slider-runnable-track {
  height: 4px;
  background-color: #6f7f7b; /* <-- LINE COLOR */
  border-radius: 4px;
}

/* Firefox */
.price-field input[type="range"]::-moz-range-track {
  height: 4px;
  background-color: #6f7f7b; /* <-- LINE COLOR */
  border-radius: 4px;
}
/* ===== ACTIVE RANGE ===== */
.price-field::before {
  content: "";
  position: absolute;
  height: 4px;
  background: #728080; /* 👈 ACTIVE COLOR */
  top: 6%;
  transform: translateY(0%);
  left: var(--left, 0%);
  right: calc(100% - var(--right, 100%));
  border-radius: 4px;
  z-index: 2;
}
.price-field input[type="range"]::-webkit-slider-runnable-track {
  height: 4px;
  background: #cfd6d3; /* inactive */
  border-radius: 4px;
}

.price-field input[type="range"]::-moz-range-track {
  height: 4px;
  background: #cfd6d3;
  border-radius: 4px;
}
