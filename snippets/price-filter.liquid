<script>
(function () {

  function initPriceRange() {
    const range = document.querySelector(".js-price-range");
    if (!range) return;

    const lower = range.querySelector(".lower");
    const upper = range.querySelector(".upper");

    const minTooltip = document.querySelector(".price-wrap-1");
    const maxTooltip = document.querySelector(".price-wrap-2");

    if (!lower || !upper || !minTooltip || !maxTooltip) return;

    const min = Number(lower.min);
    const max = Number(lower.max);
    const gap = 0; // 0 = touch allowed, 1 = thoda gap

    function updateFromLower() {
      let lowerVal = Number(lower.value);
      let upperVal = Number(upper.value);
      // ❗ ONLY lower ko clamp karo
      if (lowerVal > upperVal - gap) {
        lowerVal = upperVal - gap;
        lower.value = lowerVal;
      }

      updateUI();
    }

    function updateFromUpper() {
      let lowerVal = Number(lower.value);
      let upperVal = Number(upper.value);

      // ❗ ONLY upper ko clamp karo
      if (upperVal < lowerVal + gap) {
        upperVal = lowerVal + gap;
        upper.value = upperVal;
      }

      updateUI();
    }

function updateUI() {
  let lowerVal = Number(lower.value);
  let upperVal = Number(upper.value);

  const lowerPercent = ((lowerVal - min) / (max - min)) * 100;
  const upperPercent = ((upperVal - min) / (max - min)) * 100;

  // ✅ Ensure upper dot never goes left of lower dot
  const safeUpperPercent = Math.max(upperPercent, lowerPercent);

  range.style.setProperty("--left", lowerPercent + "%");
  range.style.setProperty("--right", safeUpperPercent + "%");

  minTooltip.style.left = lowerPercent + "%";
  maxTooltip.style.left = safeUpperPercent + "%";

  minTooltip.querySelector("input").value = `$${lowerVal.toLocaleString()}`;
  maxTooltip.querySelector("input").value = `$${upperVal.toLocaleString()}`;
    }

    // Initial sync
    requestAnimationFrame(updateUI);

    lower.addEventListener("input", updateFromLower);
    upper.addEventListener("input", updateFromUpper);
  }

  document.addEventListener("DOMContentLoaded", initPriceRange);

  // Shopify DOM re-render safe
  const observer = new MutationObserver(initPriceRange);
  observer.observe(document.body, { childList: true, subtree: true });

})();
</script>
{% endcomment %}
<script>
(function () {

  function initAllPriceRanges() {
    document.querySelectorAll(".js-price-range").forEach(range => {

      if (range.dataset.init === "true") return;
      range.dataset.init = "true";

      const lower = range.querySelector(".lower");
      const upper = range.querySelector(".upper");

      const panel = range.closest("floating-panel-component");
      if (!panel) return;

      const minTooltip = panel.querySelector(".price-wrap-1");
      const maxTooltip = panel.querySelector(".price-wrap-2");

      const minInput = panel.querySelector("#Price-GTE");
      const maxInput = panel.querySelector("#Price-LTE");

      if (!lower || !upper || !minTooltip || !maxTooltip) return;

      const min = Number(lower.min);
      const max = Number(upper.max);
      const gap = 0;

      function updateUI(triggerFilter = false) {
        let lowerVal = Number(lower.value);
        let upperVal = Number(upper.value);

        if (lowerVal > upperVal - gap) lowerVal = upperVal - gap;
        if (upperVal < lowerVal + gap) upperVal = lowerVal + gap;

        lower.value = lowerVal;
        upper.value = upperVal;

        const lowerPercent = ((lowerVal - min) / (max - min)) * 100;
        const upperPercent = ((upperVal - min) / (max - min)) * 100;

        range.style.setProperty("--left", lowerPercent + "%");
        range.style.setProperty("--right", upperPercent + "%");

        minTooltip.style.left = lowerPercent + "%";
        maxTooltip.style.left = upperPercent + "%";
        // ✅ ALWAYS SHOW $
        minTooltip.querySelector("input").value = `$${lowerVal.toLocaleString()}`;
        maxTooltip.querySelector("input").value = `$${upperVal.toLocaleString()}`;

        // ✅ Sync Shopify inputs
        if (minInput) minInput.value = lowerVal;
        if (maxInput) maxInput.value = upperVal;

        // ✅ TRIGGER FILTER UPDATE
        if (triggerFilter) {
          minInput?.dispatchEvent(new Event("change", { bubbles: true }));
          maxInput?.dispatchEvent(new Event("change", { bubbles: true }));
        }
      }

      // Slider events
      lower.addEventListener("input", () => updateUI());
      upper.addEventListener("input", () => updateUI());

      // 🔥 APPLY FILTER ON SLIDER RELEASE
      lower.addEventListener("change", () => updateUI(true));
      upper.addEventListener("change", () => updateUI(true));

      // ✅ INITIAL FIX (dialog open / first load)
      requestAnimationFrame(() => updateUI());

    });
  }

  document.addEventListener("DOMContentLoaded", initAllPriceRanges);

  // Shopify dialog / facet re-render safe
  const observer = new MutationObserver(initAllPriceRanges);
  observer.observe(document.body, { childList: true, subtree: true });

})();
</script>



