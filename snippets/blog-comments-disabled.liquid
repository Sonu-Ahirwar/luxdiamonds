{% stylesheet %}
    .custom-blog-comments {
        padding: 40px 80px;
        margin-top: 30px;
        background-color: #fff;
    }
    .custom-blog-comments-title{
        font-family: 'Lato', sans-serif;
        font-weight:600;
        font-size: 16px;
        line-height: 1.4;
        color: #262726;
        text-transform: unset;
        letter-spacing: 0px;
        padding-bottom: 20px;
        margin-bottom: 30px;
        border-bottom: 1px solid rgb(47, 46, 46);   
    }
    .custom-blog-comments-box {
        border: 1px solid;
        padding: 20px;
    }
    p.custom-blog-comments-text {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-family: 'AvenirLTStd';
        font-weight:400;
        font-size: 16px;
        line-height: 1.4;
        color: #262726;
    }
    @media screen and (max-width:767px){
        .custom-blog-comments {
            padding: 40px 0px;
        }
        .custom-blog-comments-title {
            padding-left: 20px;
        }
        .custom-blog-comments-box {
            margin: 0px 20px;
        }
        .custom-blog-comments-text svg{
            width: 16px;
        }
        .custom-blog-comments-text span{
            width: calc(100% - 26px);
        }
    }
{% endstylesheet %}