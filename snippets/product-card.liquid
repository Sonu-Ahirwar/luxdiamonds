{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block, featured product block, and the product card block.
  The product object is null or when placeholders are rendered.

  @param {object} product - The product object
  @param {object} children - The children of the product card
  @param {object} [block] - The block object
  @param {number} [product_card_gap] - The gap between the product card children (overrides block settings)
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% if product == blank %}
  {% break %}
{% endif %}

{% style %}
  {% if request.visual_preview_mode %}
    product-card-link {
      width: 100%;
      min-width: 250px;
    }
  {% endif %}
{% endstyle %}

{% liquid
  assign has_quick_add = false
  if settings.quick_add and product.available
    assign has_quick_add = true
  endif

  assign has_mobile_quick_add = false
  if has_quick_add and settings.mobile_quick_add
    assign has_mobile_quick_add = true
  endif

  assign product_card_id = 'product-card-link-' | append: block.id | append: '-' | append: product.id
  assign product_card_gap_value = product_card_gap | default: block_settings.product_card_gap

  # Logic to determine which variant URL to use (matching swatch selection logic)
  assign variant_to_link = product.selected_or_first_available_variant
  assign combined_listing_count = product.options_with_values | map: 'values' | map: 'product_url' | compact | size
  assign no_swatch_selected = null

  unless combined_listing_count > 0
    # Simple direct check: which variant owns the featured image?
    if product.featured_media
      assign found_variant = false

      for variant in product.variants
        if variant.featured_media.id == product.featured_media.id
          assign variant_to_link = variant
          assign found_variant = true
          break
        endif
      endfor

      # Check if we need to set no_swatch_selected
      unless found_variant
        # Featured image is not a variant image
        # Check if product has swatches
        for option in product.options_with_values
          assign swatch_count = option.values | map: 'swatch' | compact | size
          if swatch_count > 1
            # Multiple swatches exist but featured image doesn't match any
            assign no_swatch_selected = true
            break
          endif
        endfor
      endunless
    endif
  endunless

  if settings.transition_to_main_product
    assign featured_image = variant_to_link.featured_image
    if featured_image == blank
      assign featured_image = product.featured_media.preview_image
    endif

    if featured_image != blank
      assign featured_media_url = featured_image | image_url: width: 500
    endif
  endif

  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif

  # Assign product variable
  assign prod = product

  # === Metafield read (6 fields, parent-aware) ===
  assign fields = 'all_sku_plp,all_sku_plp_1,all_sku_plp_2' | split: ','
  assign mf_items = '' | split: ','

  for f in fields
    assign m = prod.metafields.custom[f]
    if m != blank and m.value != blank
      assign mf_items = mf_items | concat: m.value
    endif
  endfor

  assign mf = mf_items

  # agar current product PLP clone hai (parent_handle set hai) to parent se JSON lo
  assign parent_handle_mf = prod.metafields.custom.parent_handle.value | default: ''
  if mf == blank and parent_handle_mf != ''
    assign parent_prod = all_products[parent_handle_mf]
    if parent_prod != blank
      assign parent_items = '' | split: ','
      for f in fields
        assign pm = parent_prod.metafields.custom[f]
        if pm != blank and pm.value != blank
          assign parent_items = parent_items | concat: pm.value
        endif
      endfor
      assign mf = parent_items
    endif
  endif


  # === Image (fallback) ===
  assign img_src = ""
  if prod.featured_media
    assign img_src = prod.featured_media | image_url: width: 900
  endif

  # === From price fallback ===
  assign min_cents = blank
  if prod.price and prod.price > 0
    assign min_cents = prod.price
  endif
  
%}
{%- liquid
  assign sku_list = mf
  if mf.value != blank
    assign sku_list = mf.value
  endif

  assign linkParameter = ''
-%}



{%- liquid
  assign sku_list = mf
  if mf.value != blank
    assign sku_list = mf.value
  endif

  assign picked = blank

  # 1) by card sku (product-card dataset)
  assign card_sku = prod.selected_or_first_available_variant.sku | default: ''
  # Agar tumhare product-card me already data-card-sku set hai from metafield, then use that variable instead.
  # (best: pass picked.sku itself as data-card-sku)

  # 2) product_rank_category lowest number
  assign best_rank = 999999
  if sku_list != blank
    for s in sku_list
      assign r = s.product_rank_category | default: '' | plus: 0
      if r > 0 and r < best_rank
        assign best_rank = r
        assign picked = s
      endif
    endfor
  endif

  # 3) show_on_plp YES
  if picked == blank and sku_list != blank
    for s in sku_list
      if s.show_on_plp == 'YES'
        assign picked = s
        break
      endif
    endfor
  endif

  # 4) fallback first
  if picked == blank and sku_list != blank
    assign picked = sku_list[0]
  endif
-%}

{% assign selected_color = blank %}

{% for filter in collection.filters %}
  {% if filter.param_name contains 'metal' %}
    {% for value in filter.active_values %}
      {% assign selected_color = value.label %}
    {% endfor %}
  {% endif %}
{% endfor %}

{%- liquid
  assign prod_obj = product

  # ---- combine chunks ----
  assign fields = 'all_sku_plp,all_sku_plp_1,all_sku_plp_2' | split: ','
  assign mf_items = '' | split: ','

  for f in fields
    assign m = prod_obj.metafields.custom[f]
    if m != blank and m.value != blank
      assign mf_items = mf_items | concat: m.value
    endif
  endfor

  # ---- defaults from metafields ----
  assign default_sku = prod_obj.metafields.custom.default_sku.value | default: '' | strip
  assign default_metal = prod_obj.metafields.custom.active_metal_on_plp.value | default: '' | strip
  assign default_shape = prod_obj.metafields.custom.active_shape_on_plp.value | default: '' | strip

  # ---- read URL filter (Search & Discovery) ----
  assign url_metal = ''
  assign url_shape = ''

  assign qs = request.query_string | default: ''
  if qs != ''
    assign parts = qs | split: '&'
    for p in parts
      if p contains 'filter.p.m.custom.metal='
        assign url_metal = p | split: '=' | last | url_decode | strip
        assign url_metal_sel = p | split: '=' | last | url_decode | strip
      endif
      if p contains 'filter.p.m.custom.shape='
        assign url_shape = p | split: '=' | last | url_decode | strip
        assign url_shape_sel = p | split: '=' | last | url_decode | strip
      endif
    endfor
  endif

  # ---- FINAL desired selections (URL > metafield defaults) ----
  assign want_metal = url_metal
  if want_metal == ''
    assign want_metal = default_metal
  endif

  assign want_shape = url_shape
  if want_shape == ''
    assign want_shape = default_shape
  endif

  # ---- pick row (speed-safe: 1-row JSON only) ----
  assign picked_row = blank

  # (A) Strict match by URL/default metal+shape
  if picked_row == blank and want_metal != '' and want_shape != '' and mf_items != blank
    for s in mf_items
      if s.metal_color == want_metal and s.center_stone_shape == want_shape and product.selected_or_first_available_variant.sku == s.sku
        assign picked_row = s
        break
      endif
    endfor
  endif

  # (B) Metal only
  if picked_row == blank and want_metal != '' and mf_items != blank
    for s in mf_items
      if s.metal_color == want_metal and product.selected_or_first_available_variant.sku == s.sku
        assign picked_row = s
        break
      endif
    endfor
  endif

  # (C) Shape only
  if picked_row == blank and want_shape != '' and mf_items != blank
    for s in mf_items
      if s.center_stone_shape == want_shape and product.selected_or_first_available_variant.sku == s.sku
        assign picked_row = s
        break
      endif
    endfor
  endif

  # (D) default_sku
  if picked_row == blank and default_sku != '' and mf_items != blank 
    assign picked_row = mf_items | where: 'sku', default_sku | first
  endif

  # (E) show_on_plp YES
  if picked_row == blank and mf_items != blank
    assign picked_row = mf_items | where: 'show_on_plp', 'YES' | first
  endif

  # (F) fallback first
  if picked_row == blank and mf_items != blank
    assign picked_row = mf_items | first
  endif
-%}

{%- liquid
  assign linkParameter = ''
  if picked_row != blank and picked_row.url_key != blank
    assign linkParameter = '?new_url=' | append: picked_row.url_key
  endif
-%}

<script type="application/json" class="wdd-skudata-val">{{ picked_row | json }}</script>


{%- liquid
  # Parent handle metafield (PLP clones ke liye)
  assign parent_handle_mf = prod.metafields.custom.parent_handle

  if parent_handle_mf == blank
    assign parent_handle_mf = ''
  endif

  if parent_handle_mf != ''
    # 👉 PLP product → parent PDP pe bhejna
    assign base_card_url = routes.root_url | append: 'products/' | append: parent_handle_mf
     if collection.handle != blank
          assign base_card_url = routes.root_url | append: collection.url | append: 'products/' | append: parent_handle_mf
    endif
  else
    # 👉 Normal product → tumhara existing variant URL
    assign base_card_url = variant_to_link.url
  endif
-%}

{%- if settings.transition_to_main_product -%}
  <product-card-link
    data-product-url="{{ base_card_url | split: '?variant' | first  }}{{ linkParameter }}"
    data-product-id="{{ product.id }}"
    data-featured-media-url="{{ featured_media_url }}"
    data-product-transition="{{ settings.transition_to_main_product }}"
    data-handle="{{ prod.handle }}"
    {% if onboarding %}
      data-placeholder="true"
    {% endif %}
    hrf="{{ base_card_url | split: '?variant' | first  }}{{ linkParameter }}"
  >
{%- endif -%}
<product-card data-product-url="{{ base_card_url| split: '?variant' | first  }}{{ linkParameter }}"
  class="product-card himanshu productcard_{{ prod.id }}"
  data-product-id="{{ product.id }}"
  data-handle="{{ prod.handle }}"
  data-card-sku="{% if selected_color != blank %}
  {% if picked_row.sku %}{{ picked_row.sku }} {% else %}{{ product.metafields.custom.defaul_sku.value | escape }}{% endif %}{% else %}{{ product.metafields.custom.defaul_sku.value | escape }}{% endif %}"
  data-product-variants-size="{{ product.variants.size }}"
  id="product-card-{{ block.id }}"
  data-product-transition="{{ settings.transition_to_main_product }}"
  data-default-productName="{{ product.metafields.custom.pdp_title.value }}"
  data-default-sku="{{ product.metafields.custom.defaul_sku.value | escape }}"
  data-default-metal="{% if selected_color != blank %}{{ selected_color }}{% else %}{{ product.metafields.custom.active_metal_on_plp.value | escape }}{% endif %}" 
  data-default-shape="{{ product.metafields.custom.active_shape_on_plp.value | escape }}" 
  data-selected-shape="{{ url_shape_sel }}"
  data-selected-metal="{{ url_metal_sel }}"
  {{ block.shopify_attributes }}
  {% if no_swatch_selected %}
    data-no-swatch-selected="true"
  {% endif %}
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
>

  
  {% comment %} <product-card data-product-url="{{ base_card_url }}{% if base_card_url contains '?' %}&{% else %}?{% endif %}{{ linkParameter }}"
  class="product-card himanshu productcard_{{ prod.id }}"
  data-product-id="{{ product.id }}"
  data-handle="{{ prod.handle }}"
  data-card-sku="{{ product.metafields.custom.defaul_sku.value | escape }}"
  data-product-variants-size="{{ product.variants.size }}"
  id="product-card-{{ block.id }}"
  data-product-transition="{{ settings.transition_to_main_product }}"
  data-default-sku="{{ product.metafields.custom.defaul_sku.value | escape }}"
  data-default-metal="{{ product.metafields.custom.active_metal_on_plp.value | escape }}"
  data-default-shape="{{ product.metafields.custom.active_shape_on_plp.value | escape }}"
  {{ block.shopify_attributes }}
  {% if no_swatch_selected %}
    data-no-swatch-selected="true"
  {% endif %}
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
> {% endcomment %}
  {% comment %} {{picked_row.url_key }}====**** {% endcomment %}
   <a
    id="{{ product_card_id | md5 }}"
    {% unless onboarding %}
      href="{{ base_card_url | split: '?variant' | first }}{{ linkParameter }}"
    {% endunless %}
    class="product-card__link"
    ref="productCardLink"
  >
    <span class="visually-hidden">
      {{ product.title }} 
    </span>
  </a>
  
  <div
    class="
      product-card__content
      layout-panel-flex
      layout-panel-flex--column
      product-grid__card
      spacing-style
      border-style
      gap-style
      {% if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}
    "
    style="
      {% render 'border-override', settings: block_settings %}
      {% render 'layout-panel-style', settings: block_settings %}
      {% render 'spacing-style', settings: block_settings %}
      {% render 'gap-style', value: product_card_gap_value, name: 'product-card-gap' %}
      --quick-add-display: {% if has_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-display: {% if has_mobile_quick_add %}flex{% else %}none{% endif %};
      {% if block_settings.padding-inline-start > 0 %}--zoom-out-padding-inline-start: min(var(--padding-xs), {{ block_settings.padding-inline-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-inline-end > 0 %}--zoom-out-padding-inline-end: min(var(--padding-xs), {{ block_settings.padding-inline-end | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-start > 0 %}--zoom-out-padding-block-start: min(var(--padding-xs), {{ block_settings.padding-block-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-end > 0 %}--zoom-out-padding-block-end: min(var(--padding-xs), {{ block_settings.padding-block-end | times: 0.7}}px);{% endif %}
    "
  >
    
{%- liquid
  assign metalvalue = prod.metafields.custom.available_metals.value | default: '' | split: ',' | map: 'strip'
  assign shapevalue = prod.metafields.custom.available_shapes.value | default: '' | split: ',' | map: 'strip'
-%}
    {{ children }}
  </div>
   {% comment %} <script type="application/json" class="wdd-skudata-val">
  {%- if template contains 'collection' -%}null{%- else -%}{{ mf.value | json }}{%- endif -%}
</script> {% endcomment %}
{% comment %} <script type="application/json" class="wdd-skudata-val">
  {{ mf.value | json }}
</script> {% endcomment %}
{% comment %} <script type="application/json" class="wdd-skudata-val">
  {{ picked | json }}
</script> {% endcomment %}
{% comment %} <script type="application/json" class="wdd-skudata-val">
  {%- if template contains 'collection' -%}null{%- else -%}{{ mf.value | json }}{%- endif -%}
</script> {% endcomment %}
{% comment %} <script type="application/json" class="wdd-skudata-val">
  {%- if template contains 'collection' -%}
    {{ picked | json }}
  {%- else -%}
    {{ mf.value | json }}
  {%- endif -%}
</script> {% endcomment %}



</product-card>
{%- if settings.transition_to_main_product -%}
  </product-card-link>
{%- endif -%}

{% stylesheet %}
  product-card-link,
  :not(product-card-link) product-card {
    width: 100%;
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }

  /* Hide the variant swatches for product cards that show a swatches variant picker */
  :is(.product-card):has(swatches-variant-picker-component) .quick-add .variant-option--swatches {
    display: none;
  }

  /* Hide "Add" button for single option product cards that show a swatches variant picker */
  :is(.product-card:not([data-no-swatch-selected])):has(.quick-add__product-form-component--single-option):has(
      swatches-variant-picker-component
    )
    .quick-add__button--choose {
    display: none;
  }

  /* Hide "Add" button for single option product cards that show a swatches variant picker */
  :is(.product-card[data-no-swatch-selected]):has(.quick-add__product-form-component--single-option):has(
      swatches-variant-picker-component
    )
    add-to-cart-component {
    display: none;
  }

  /* Hide "add" button for multi-variant product cards that don't show a swatches variant picker */
  :is(.product-card):has(.quick-add__product-form-component--multi-variant):not(:has(swatches-variant-picker-component))
    .quick-add__button--add {
    display: none;
  }

  /* Hover effect for single variant product cards and product blocks */

  /* stylelint-disable selector-max-specificity */
  :is(.product-card):has(.quick-add__product-form-component--single-variant) .card-gallery:hover {
    & .quick-add__button--choose {
      display: none;
    }

    & .quick-add__button--add {
      display: grid;
    }
  }

  .product-card[data-no-swatch-selected] slideshow-component[data-generic-media-size='1'] slideshow-arrows {
    display: none;
  }

  .product-card[data-no-swatch-selected]
    slideshow-component[data-generic-media-size='1']
    slideshow-arrows:has(+ slideshow-slides slideshow-slide[variant-image]:not([hidden])) {
    display: flex;
  }

  .product-card .variant-option__swatch svg {
    display: none;
  }

  .product-card [data-available-count='0'] ~ svg {
    display: block;
  }
{% endstylesheet %}

