{%- doc -%}
  @param [limit] - {number}
  @param [live_region] - {boolean}

  The maximum number of items in the cart to display. If the number of items in the cart is greater than this limit, the
  count will be displayed as "99+".
{%- enddoc -%}

<div
  ref="cartBubble"
  class="cart-bubble"
  {% assign item_count = cart.item_count %}
  {% if item_count <= 99 %}
    data-maintain-ratio
  {% endif %}
>
  <span class="cart-bubble__background"></span>
  <span
    ref="cartBubbleText"
    id="cart-bubble-text"
    class="cart-bubble__text"
    {% if live_region %}
      role="status"
    {% endif %}
  >
    <span class="visually-hidden">
      {{- 'accessibility.cart_count' | t -}}
      : {{ cart.item_count }}
    </span>
    <span
      class="cart-bubble__text-count"
      ref="cartBubbleCount"
      aria-hidden="true"
      data-testid="cart-bubble"
    >
      {%- if limit == blank or cart.item_count < limit %}
        {{- cart.item_count -}}
      {%- endif -%}
    </span>
  </span>
</div>




{% comment %} 
{%- doc -%}
  @param [limit] - {number}
  @param [live_region] - {boolean}

  The maximum number of items in the cart to display.
  If the number of items in the cart is greater than this limit,
  the count will be displayed as "99+".
{%- enddoc -%}

{%- assign item_count = cart.item_count | default: 0 -%}

<div
  ref="cartBubble"
  class="cart-bubble"
  {% if item_count <= 99 %}
    data-maintain-ratio
  {% endif %}
>
  <span class="cart-bubble__background"></span>

  <span
    ref="cartBubbleText"
    id="cart-bubble-text"
    class="cart-bubble__text"
    {% if live_region %}
      role="status"
    {% endif %}
  >
    <!-- Accessibility text -->
    <span class="visually-hidden">
      {{- 'accessibility.cart_count' | t -}}: {{ item_count }}
    </span>

    <!-- Visible count -->
    <span
      class="cart-bubble__text-count"
      ref="cartBubbleCount"
      aria-hidden="true"
      data-testid="cart-bubble"
    >
      {%- if item_count == 0 -%}
        0
      {%- elsif limit == blank or item_count < limit -%}
        {{- item_count -}}
      {%- else -%}
        99+
      {%- endif -%}
    </span>
  </span>
</div> {% endcomment %}
