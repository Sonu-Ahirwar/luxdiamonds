<script>
  (function () {
    const SLIDES_TO_SHOW = 9;

    function setSlideWidths(slider) {
      const parent = slider.closest('.facets__slider-wrapper') || slider.parentElement;

      const containerWidth = parent.getBoundingClientRect().width;
      if (!containerWidth || containerWidth < 100) return;

      const firstItem = slider.children[0];
      if (!firstItem) return;

      const style = window.getComputedStyle(firstItem);
      const margin = parseFloat(style.marginLeft) + parseFloat(style.marginRight);

      const totalGap = margin * (SLIDES_TO_SHOW - 1);
      const itemWidth = (containerWidth - totalGap) / SLIDES_TO_SHOW;

      [...slider.children].forEach((li) => {
        li.style.flex = `0 0 ${itemWidth}px`;
        li.style.maxWidth = `${itemWidth}px`;
      });

      // 🔥 IMPORTANT PART
      slider.dataset.index = 0;
      slider.dataset.step = itemWidth + margin;
      slider.dataset.startOffset = firstItem.offsetLeft; // 👈 FIX
    }

    function initSliders() {
      document.querySelectorAll('.facets__inputs-list--slider').forEach((slider) => {
        setSlideWidths(slider);
      });
    }

    // Arrow scroll (1 item per click)
   window.scrollFacetSlider = function (filterId, direction) {
  const slider = document.querySelector(`#filters-list-${filterId}`);
  if (!slider) return;

  const firstItem = slider.children[0];
  if (!firstItem) return;

  const style = window.getComputedStyle(firstItem);
  const margin = parseFloat(style.marginRight) || 0;

  const step = firstItem.offsetWidth + margin;

  slider.scrollBy({
    left: step * direction,
    behavior: 'smooth',
  });
};


    // Init on load
    window.addEventListener('load', initSliders);

    // Recalculate on resize
    window.addEventListener('resize', initSliders);

    // 🔥 VERY IMPORTANT: when tab opens
    document.addEventListener('click', (e) => {
      const tab = e.target.closest('[data-tab]');
      if (tab) {
        setTimeout(initSliders, 50);
      }
    });
  })();
</script>

