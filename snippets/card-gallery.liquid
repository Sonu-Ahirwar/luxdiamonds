{%- doc -%}
  Displays product images in a carousel.
  Settings allow for a full slideshow, showing only the first image, or showing the second image when hovering.
  Note: When the product card itself is in a carousel layout, the card-gallery's carousel is disabled with JavaScript.

  @param [children] - Additional content rendered below the card gallery
  @param [section] - The section object the snippet is rendered in
  @param [block] - The block object the snippet is rendered in
  @param [has_applied_colour_filter] - Whether there's an applied colour filter
{%- enddoc -%}

{% liquid
  assign product = closest.product
  assign block_settings = block.settings
  assign image_sizes = '(min-width: 750px) 50vw, 100vw'

  # if the card-gallery has a section.settings.product_card_size:
  # assume grid-template autofill(card-size, 1fr) and calculate the sizes attribute based on the minimum card size
  #
  # if section has section.settings.columns:
  # assume grid-template repeat(column-count, 1fr) and calculate the sizes attribute based on the number of columns
  if section.settings.product_card_size
    capture card_size
      render 'util-product-grid-card-size', section: section
    endcapture
    assign card_size = card_size | strip | replace: 'px', '' | plus: 0
    capture sizes_attribute
      render 'util-autofill-img-size-attr', card_size: card_size, card_gap: section.settings.columns_gap_horizontal
    endcapture
    assign image_sizes = sizes_attribute | strip
  elsif section.settings.columns and section.settings.layout_type != 'editorial'
    assign viewport_width = 100.0 | divided_by: section.settings.columns
    assign sizes_attribute = '(min-width: 750px) [viewport_width]vw, 100vw' | replace: '[viewport_width]', viewport_width
    assign image_sizes = sizes_attribute | strip
  endif

  assign ratio = '1'
  case block_settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'square'
      assign ratio = '1'
    when 'adapt'
      if product != blank
        assign current_featured_image_for_ratio = product.featured_image
        if current_featured_image_for_ratio == blank and product.featured_media.preview_image != blank
          assign current_featured_image_for_ratio = product.featured_media.preview_image
        endif

        if current_featured_image_for_ratio != blank and current_featured_image_for_ratio.aspect_ratio != null and current_featured_image_for_ratio.aspect_ratio > 0
          assign ratio = current_featured_image_for_ratio.aspect_ratio
        endif
      endif
  endcase

  assign selected_variant_image = product.selected_or_first_available_variant.image.src
  assign cdn_prefix = 'https://im.lgdus.co/Jwl/'


  if block_settings.image_ratio == 'adapt' and block_settings.constrain_to_viewport
    if block_settings.constrain_to_viewport != ''
      assign constrain_to_viewport = true
      assign media_fit = block_settings.constrain_to_viewport
    endif
  endif

  assign all_media = product.media

  # For combined listings: make sure to include the featured media of the color variants so that the swatch picker
  # works as expected.
  for product_option in product.options_with_values
    for product_option_value in product_option.values
      if product_option_value.swatch
        assign featured_media = product_option_value.variant.featured_media

        # If the variant has no featured media, and we have a combined listing product, then fall back to using the
        # featured media of the child product that is linked to this option value.

        if featured_media == blank and product_option_value.product_url
          assign featured_media = product_option_value.variant.product.featured_media
        endif

        assign existing_media = all_media | has: 'id', featured_media.id
        unless existing_media
          assign variant_featured_media = product_option_value.variant.product.media | where: 'id', featured_media.id
          assign all_media = all_media | concat: variant_featured_media
        endunless
      endif
    endfor
  endfor

  # === Parent handle based URL override ===
  assign parent_handle_mf = product.metafields.custom.parent_handle

  if parent_handle_mf == blank
    assign parent_handle_mf = ''
  endif

  if parent_handle_mf != ''
    # PLP clone → parent PDP pe bhejna
    assign base_card_url = routes.root_url | append: 'products/' | append: parent_handle_mf
    if collection.handle != blank
          assign base_card_url = routes.root_url | append: collection.url | append: 'products/' | append: parent_handle_mf
    endif
  else
    # Normal product → theme ka default variant URL
    capture default_card_url
      render 'product-card-variant-url', product: product
    endcapture
    assign base_card_url = default_card_url | strip
  endif

  assign prod = product

  # ---------- JSON SOURCE (PLP) ----------
  assign use_prod = prod
  assign parent_handle_val = prod.metafields.custom.parent_handle.value | default: ''
  if parent_handle_val != ''
    assign parent_prod = all_products[parent_handle_val]
    if parent_prod != blank
      assign use_prod = parent_prod
    endif
  endif

  assign fields = 'all_sku_plp,all_sku_plp_1,all_sku_plp_2' | split: ','
  assign mf_items = '' | split: ','

  for f in fields
    assign m = use_prod.metafields.custom[f]
    if m != blank and m.value != blank
      assign mf_items = mf_items | concat: m.value
    endif
  endfor

  assign sku_list = mf_items

  # ---------- DEFAULT ROW PICK (exact product default) ----------
  # Priority:
  # 1) if current_tags present -> match metal or shape (as your filters)
  # 2) else if selected variant sku exists -> match sku
  # 3) else first row
  assign picked = blank
  assign card_sku = product.selected_or_first_available_variant.sku | default: '' | strip

  if current_tags != blank and sku_list != blank
    for s in sku_list
      if current_tags contains s.metal_color and current_tags contains s.center_stone_shape
        assign picked = s
        break
      endif
    endfor

    if picked == blank
      for s in sku_list
        if current_tags contains s.metal_color
          assign picked = s
          break
        endif
      endfor
    endif


    if picked == blank
      for s in sku_list
        if current_tags contains s.center_stone_shape
          assign picked = s
          break
        endif
      endfor
    endif
  endif

  if picked == blank and card_sku != '' and sku_list != blank
    for s in sku_list
      assign s_sku = s.sku | default: '' | strip
      if s_sku != '' and s_sku == card_sku
        assign picked = s
        break
      endif
    endfor
  endif

    if picked 
      for s in sku_list
        if current_tags contains s.gemstone_type
          assign picked = s
          break
        endif
      endfor
    endif
    
  if picked == blank and sku_list != blank
    assign picked = sku_list[0]
  endif
  
   assign picked_row = blank
  assign selected_color = blank

  assign count = 0
  for filter in collection.filters 
   if filter.param_name contains 'metal' 
     for value in filter.active_values 
     assign count = count | plus: 1
      if count <= 1
       assign selected_color = value.label 
       endif
     endfor 
   endif 

   
  assign count_s = 0
   if filter.param_name contains 'shape' 
     for value in filter.active_values 
     assign count_s = count_s | plus: 1
      if count_s <= 1
       assign selected_shape = value.label 
       endif
     endfor 
   endif 

  assign count_g = 0
    if filter.param_name contains 'gemstone' 
     for value in filter.active_values 
     assign count_g = count_g | plus: 1
      if count_g <= 1
       assign selected_gem = value.label 
       endif
     endfor 
   endif 
 endfor 

 assign filter_metal = selected_color 
 assign filter_shape = selected_shape 
 assign filter_gem = selected_gem 
 assign filter_shape_meta = product.metafields.custom.active_shape_on_plp.value | escape 
 assign filter_metal_meta = product.metafields.custom.active_metal_on_plp.value | escape 

 assign filtered_rows = mf_items  | where: 'metal_color', filter_metal  | where: 'center_stone_shape', filter_shape 

   
  if picked_row == blank
    assign picked_row = filtered_rows | first 
  endif
 
  # Build metal/shape arrays for chips
  assign metalvalue = blank
  assign shapevalue = blank
  for it in sku_list
    if it.metal_color != blank
      if metalvalue != blank
        assign metalvalue = metalvalue | append: ', '
      endif
      assign metalvalue = metalvalue | append: it.metal_color
    endif
    if it.center_stone_shape != blank
      if shapevalue != blank
        assign shapevalue = shapevalue | append: ', '
      endif
      assign shapevalue = shapevalue | append: it.center_stone_shape
    endif
  endfor
  assign metalvalue = metalvalue | split: ', ' | uniq | join: ', ' | split: ', '
  assign shapevalue = shapevalue | split: ', ' | uniq | join: ', ' | split: ', '
%}

{%  if filter_gem != blank %}
 {%  for row in filtered_rows %}
   {%  assign gemstone_values = row.gemstone_type | downcase %}
   {%  if gemstone_values contains filter_gem %}
     {% assign matched_products = row %}
     {%  break%}
   {%  endif%}
 {%  endfor%}
{% endif %}
{% if matched_products %}
{%  assign picked = matched_products %}
{% endif %}

<div
  ref="cardGallery"
  class="card-gallery card-gallery-{{ block.id }} spacing-style border-style"
  style="
    {% render 'border-override', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --gallery-aspect-ratio: {{ ratio }};
  "
  data-product-id="{{ product.id }}"
  data-initial-media1="{{ 'https://im.lgdus.co/Jwl/' | append: picked.media1 }}"
  {% if picked.hover_image1 != blank or  picked.media2 != blank %}
     data-initial-media2="{{ 'https://im.lgdus.co/Jwl/' | append: picked.hover_image1 | default: picked.media2 }}"
  {% else %}
     data-initial-media2="{{ 'https://im.lgdus.co/Jwl/' | append: picked.media1 }}"
  {% endif %}
  {% if settings.show_second_image_on_hover %}
    on:pointerenter="/previewImage"
    on:pointerleave="/resetImage"
  {% endif %}
  {% if settings.transition_to_main_product %}
    data-view-transition-to-main-productZ
  {% endif %}
  data-image-ratio="{{ block_settings.image_ratio }}"
  {{ block.shopify_attributes }}
>
{% unless collection.handle == 'new-arrivals' or collection.handle == 'custom-jewelry' %}
