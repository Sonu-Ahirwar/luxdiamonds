    <img src="https://cdn.shopify.com/s/files/1/0788/6631/7533/files/Red_Sparkle_1.png?v=1793716316" alt="sparkle">
  {% endif %}
    {{ product.metafields.custom.card_badge_name.value }}
  </div>
{% endif %}

{% if block_settings.show_icons %}
<span class="iconWrap">
  {% unless canonical_url contains 'recommendations' %}
  {% comment %} <span class="shipping_icon">
    <img src="https://dl2vs6wk2ewna.cloudfront.net/wdd/images/shipping2.png" 
      width=""
      height=""
      loading="lazy"
      alt="Shipping">
  </span> {% endcomment %}
  {% endunless %}
  <span class="add-to-wishlist">
     <div
      class="wishlist-engine"
      data-product_id="{{ product.id }}"
      data-variant_id="{{ product.selected_or_first_available_variant.id }}"
      data-product_handle="{{ parent_handle_mf | default: product.handle }}"
      data-title="{{ picked.pdp_name | default: product.title | escape }}"
      data-image="{{ 'https://im.lgdus.co/Jwl/' | append: picked.media1 | escape }}"
      data-price="{{ picked.price | default: product.price | default: 0 }}"
      data-url="{{ base_card_url | split: '?variant' | first | append: linkParameter | escape }}"
      data-sku="{{ picked.sku | default: product.selected_or_first_available_variant.sku | escape }}"
      data-metafields='{{ picked | json | escape }}'
      data-full_button="false"
      data-css="true"
    ></div>
  </span>
</span>
{% else %}
  <span class="iconWrap">
    <span class="add-to-wishlist">
     <div
      class="wishlist-engine"
      data-product_id="{{ product.id }}"
      data-variant_id="{{ product.selected_or_first_available_variant.id }}"
      data-product_handle="{{ parent_handle_mf | default: product.handle }}"
      data-title="{{ picked.pdp_name | default: product.title | escape }}"
      data-image="{{ 'https://im.lgdus.co/Jwl/' | append: picked.media1 | escape }}"
      data-price="{{ picked.price | default: product.price | default: 0 }}"
      data-url="{{ base_card_url | split: '?variant' | first | append: linkParameter | escape }}"
      data-sku="{{ picked.sku | default: product.selected_or_first_available_variant.sku | escape }}"
      data-metafields='{{ picked | json | escape }}'
      data-full_button="false"
      data-css="true"
    ></div>
  </span>
  </span>
{% endif %}

    {%- liquid
      # sku_list already built from: all_sku_plp, all_sku_plp_1, all_sku_plp_2
      assign linkParameter = ''
      assign skuData = blank

      if sku_list != blank and sku_list.size > 0
        if current_tags != blank
          for item in sku_list
            if item.metal_color != blank and current_tags contains item.metal_color
              assign skuData = item
              break
            endif

            if item.center_stone_shape != blank and current_tags contains item.center_stone_shape
              assign skuData = item
              break
            endif
          endfor
        endif       
      endif
    -%}
    {% if skuData == blank %}
  {% assign MetalValue_t = product.metafields.custom.active_metal_on_plp.value | escape  %}
  
  {% assign ShapeValue_t = product.metafields.custom.active_shape_on_plp.value | escape  %}

  {% for skuDatadate in product.metafields.custom.all_sku_plp.value  %}          
    {% assign default_name = product.metafields.custom.pdp_title.value | handleize %}
    {% assign skudefault = skuDatadate.name | handleize %}
    
    {% if MetalValue_t contains skuDatadate.metal_color and ShapeValue_t contains skuDatadate.center_stone_shape and skudefault == default_name %}    
          {% assign skuData = skuDatadate %}
          {%  break %}
      {% endif %}
    {% endfor %}

    {% assign linkParameter = '?new_url=' | append: skuData.url_key %}
    {% assign skuData = skuDatadate %}
    {% endif %}
   {% if skuData == blank %}
{%  assign skuData = sku_list | first  %}
 {% assign linkParameter = '?new_url=' | append: skuData.url_key %}
    {%  endif %}

  {%- if all_media.size > 1 -%}
    
    {% liquid
      # Check if there are generic media that are not variant images
      assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
      assign generic_media_size = all_media.size | minus: variant_images.size
      assign combined_listing_count = product.options_with_values | map: 'values' | map: 'product_url' | compact | size

      if combined_listing_count > 0 or has_applied_colour_filter
        # Sort media so selected variant image comes first
        assign selected_media = all_media | where: 'src', selected_variant_image
        assign other_media = all_media | reject: 'src', selected_variant_image
        assign all_media_sorted = selected_media | concat: other_media
        assign media_list_to_show = all_media_sorted
      else
        assign media_list_to_show = all_media
      endif

      if all_media.size > 2 and generic_media_size > 0
        assign show_arrows = true
      endif

      # Don't overfetch media if we don't need to
      assign max_visible_slide_count = 1
      if settings.product_card_carousel
        assign max_visible_slide_count = 5
      elsif settings.show_second_image_on_hover
        assign max_visible_slide_count = 2
      endif

      capture slides
        for media in media_list_to_show  limit: 2
          assign loading = 'lazy'
          assign sizes = 'auto, ' | append: image_sizes

          assign hidden = false
          assign attributes = ''
          if variant_images contains media.src
            assign attributes = 'variant-image'
            if combined_listing_count > 0
              # hide all variant images of combined listings unless it's the first image or there are no generic media
              unless forloop.first and media.src == selected_variant_image or generic_media_size == 0
                assign hidden = true
              endunless
            elsif has_applied_colour_filter
              # with colour filters, hide all variant images unless the image is the selected_variant
              unless media.src == selected_variant_image
                assign hidden = true
              endunless
            elsif forloop.first == false
              # hide all variant images that aren't the first one (when there are no combined listings or colour filters applied)
              assign hidden = true
            endif
          endif

          # Performance improvement: don't render more than 5 visible images into the slideshow
          # We'll keep the images that we need for the variant images and hover next.
          if forloop.first
            assign visible_slide_count = 0
          endif
          unless hidden
            assign visible_slide_count = visible_slide_count | plus: 1
          endunless
          if hidden == false and visible_slide_count > max_visible_slide_count
            continue
          endif

          if forloop.first and section.index == null or section.index < 5
            assign loading = 'eager'
            assign sizes = image_sizes
          endif

          assign class = 'product-media-container media-fit product-media-container--[media_type]' | replace: '[media_type]', media.media_type
          if constrain_to_viewport
            assign class = class | append: ' constrain-height'
          endif

          capture slideshow_children
            render 'product-media', media: media, sizes: sizes, loading: loading, preview_image_only: true, product: product, indeximage: forloop.index0
          endcapture

          render 'slideshow-slide', slide_id: media.id, index: forloop.index, hidden: hidden, class: class, attributes: attributes, children: slideshow_children, media_fit: media_fit, product:product
        endfor
      endcapture

      assign slideshow_attributes = 'data-generic-media-size="[generic_media_size]"' | replace: '[generic_media_size]', 2
      if settings.product_card_carousel == false
        assign slideshow_attributes = slideshow_attributes | append: ' disabled="true"'
      endif
    %}

    <a
      class="contents wdd-card-link aaaaaaa"
      ref="cardGalleryLink"
      href="{{ base_card_url | split: '?variant' | first  }}{{ linkParameter }}"
      aria-label="{{- product.title -}}"
    >
      {% render 'slideshow',
        ref: 'slideshow',
        initial_slide: 0,
        slides: slides,
        slide_count: all_media.size,
        show_arrows: show_arrows,
        attributes: slideshow_attributes
      %}
    </a>
    {% comment %} {% assign Collectionfiltershow = false %}
    {% if template == 'collection' or template == 'collection.engagement-rings' or template == 'collection.womens-wedding-bands' or template == 'collection.special' or template == 'collection.fine-jewelry' %}
      {% assign Collectionfiltershow = true %}
    {% endif %} {% endcomment %}
    {% assign Collectionfiltershow = false %}
    {% if request.page_type == 'collection' or request.page_type == 'search' %}
      {% assign Collectionfiltershow = true %}
    {% endif %}
    {% if metalvalue.size > 1 and Collectionfiltershow  %}
    <div class="wdd-metals" role="group" aria-label="Select metal" data-metals testa>
     
      {% for metal in metalvalue  %}
         {% assign active_val = false %}
        
        {% if picked != blank %}
          {% if selected_color != blank %}
              {%  if metal == selected_color %}
                {% assign active_val = true %}
              {% endif %} 
            {% else %}
              {%  if metal == filter_metal_meta %}
                {% assign active_val = true %}
              {% endif %} 
          {% endif %} 
        {% endif %}
        <button class="metal-chip page_{{page_current}} {% if active_val == true %} active {% endif %}" 
          data-metal="{{ metal }}" title="{{ metal | capitalize }}" data-productId="{{ prod.id }}" >
              <img src="{{ metal | replace: ' ', '_' | downcase | append: '.svg' | file_url }}" 
                alt="{{ metal }}" 
                title="{{ metal }}"
                height=""
                width=""
                loading="lazy" data-metal="{{ metal | capitalize }}" title="{{ metal | capitalize}}"
              data-productId="{{ prod.id }}"/>
          </button>
      {% endfor %}
    </div>
    {% endif %}
  {% elsif product != blank and product.media.size == 1 %}
     <a
      class="contents wdd-card-link new_image"
      ref="cardGalleryLink"
      href="{{ base_card_url | split: '?variant' | first }}{{ linkParameter }}"
      aria-label="{{- product.title -}}"
    >
    <slideshow-component ref="slideshow" style="--slideshow-timeline: --slide-1, --slide-2;" initial-slide="0" infinite="" data-generic-media-size="2" disabled="false" paused="">
     <slideshow-container ref="slideshowContainer">
         <slideshow-slides
      tabindex="-1"
      ref="scroller"
      {% if slide_size %}
        size="{{ slide_size }}"
      {% endif %}
      {% if slideshow_gutters %}
        gutters="{{ slideshow_gutters }}"
      {% endif %}
    >
    {% assign class = 'product-media-container media-fit product-media-container--image'  %}
         {%  if constrain_to_viewport%}
           {%  assign class = class | append: ' constrain-height'%}
        {% endif %}
    {%  for i in (1..2) %}
      {% assign image_1 = 'https://im.lgdus.co/Jwl/' | append: picked.media1 %}
      {%  if  picked.hover_image1 != blank or picked.media2 != blank %}
        {% assign image_2 = 'https://im.lgdus.co/Jwl/' | append: picked.hover_image1 | default: picked.media2 %}
      {% else %}
        {% assign image_2 = 'https://im.lgdus.co/Jwl/' | append: picked.media1 %}
      {% endif %}
        {% capture slideshow_children%}
          {% render 'product-media', media: image_1, sizes: sizes, loading: loading, preview_image_only: true, product: product, indeximage: forloop.index0 %}
        {% endcapture %}

      {%  render 'slideshow-slide', slide_id: product.featured_image.id, index: forloop.index, hidden: hidden, class: class, attributes: attributes, children: slideshow_children, media_fit: media_fit, product:product %}
    {% endfor %}
  </slideshow-slides>
  </slideshow-container>
</slideshow-component>
</a>

 {% assign Collectionfiltershow = false %}
    {% if request.page_type == 'collection' or request.page_type == 'search'%}
