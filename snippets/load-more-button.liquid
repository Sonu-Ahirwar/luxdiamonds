{%- if paginate.next -%}
  <div class="load-more-wrapper">
    <button
      type="button"
      class="button button-primary load-more-button"
      data-next-page-url="{{ request.path }}?page={{ paginate.current_page | plus: 1 }}"
      aria-label="Load more"
    >
      <span class="load-more-button__text">Load more</span>

      <span class="load-more-button__loading" hidden>
        <span class="load-more-button__spinner"></span>
        Loading
      </span>
    </button>
  </div>
{%- endif -%}

{% stylesheet %}
  .load-more-wrapper {
    display: flex;
    justify-content: center;
    padding: var(--padding-xl) var(--padding-sm);
    padding-bottom: 0;
    margin-top: var(--padding-xl);
  }

  .load-more-button {
    min-width: 200px;
    position: relative;
  }
span.load-more-button__loading[hidden] {
    display: none;
}
  .load-more-button__loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-xs);
  }

  .load-more-button__spinner {
    width: 16px;
    height: 16px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }
button.button.button-primary.load-more-button {
    background: #395754;
    border: 1px solid #b3b3b3;
    border-radius: 5px;
    color: #fff;
    transition: all .3s ease 0s;
    letter-spacing: 2px;
    min-width: 240px;
    padding-bottom: 9px;
    padding-top: 9px;
    text-transform: uppercase;
}

button.button.button-primary.load-more-button:hover {
    background: #9cadab !important;
    border-color: #9cadab !important;
}
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .load-more-button[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }
{% endstylesheet %}

