<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

{% comment %}
  Define meta data for each tab
  You can store this in settings or as metafields for easier management
{% endcomment %}

 {% comment %}
  Extract tab word from URL path
  Example: /customer-service/faq -> "faq"
{% endcomment %}

{% assign url_parts = request.path | split: 'customer-service/' %}
{% assign tab_word = url_parts[1] %}

{% if tab_word != blank %}
  {% if tab_word == 'tab-custom-design-faq' %}
    {% assign page_title_custom = 'Custom Design FAQs' %}
  
  {% elsif tab_word == 'tab-our-warranty' %}
    {% assign page_title_custom = 'Our Warranty' %}
    
  {% elsif tab_word == 'tab-shipping' %}
    {% assign page_title_custom = 'Fast, Free Shipping & Delivery ' %}
    {% assign page_description_custom = 'Enjoy the luxury of peace of mind with our fast, free, and secure shipping options from Wedding Day Diamonds. Your treasured jewelry is fully insured until it reaches you. Shop online today.' %}
  
  {% elsif tab_word == 'tab-returns-exchanges' %}
    {% assign page_title_custom = 'Hassle-Free Returns & Exchanges' %}
    {% assign page_description_custom = 'Experience luxury with confidence thanks to Wedding Day Diamonds Hassle-Free Returns & Exchanges. We guarantee a simple, trusted process for your quality jewelry purchase. Contact our customer service team today.' %}
  
  {% elsif tab_word == 'tab-appraisals' %}
    {% assign page_title_custom = 'Jewelry Appraisals: Get an Expert Value' %}
    {% assign page_description_custom = 'Ensure the true value of your fine jewelry with a trusted, expert appraisal from Wedding Day Diamonds. Protect your investment with a detailed and certified valuation. Book your appointment today!' %}
  
  {% endif %}
{% endif %}

{% assign url_parts_tag = request.path | split: '/collections/' %}
{% assign tab_word_tag = url_parts_tag[1] %}
{% if tab_word_tag != blank %}
  {% if tab_word_tag == 'fashion-rings/Diamond' %}
    {% assign page_title_custom = 'Diamond Fashion Rings' %}
    {% assign page_description_custom = 'Adorn yourself with the brilliance of diamond fashion rings at Wedding Day Diamonds in Minnesota Discover designs that sparkle and captivate' %}
  {% elsif tab_word_tag == 'engagement-rings/Nature' %}
    {% assign page_title_custom = 'Nature-Inspired Engagement Rings' %}
    {% assign page_description_custom = 'Connect with nature through Wedding Day Diamonds’ nature inspired engagement rings in Minnesota Discover designs that reflect the beauty of the natural world' %}
  {% elsif tab_word_tag == 'engagement-rings/Modern' %}
    {% assign page_title_custom = 'Modern Engagement Rings' %}
    {% assign page_description_custom = 'Explore a modern twist on engagement rings at Wedding Day Diamonds in Minnesota Discover contemporary designs that redefine tradition' %} 
  {% elsif tab_word_tag == 'engagement-rings/Emerald' %}
    {% assign page_title_custom = 'Emerald Cut Engagement Rings' %}
    {% assign page_description_custom = 'Discover the allure of emerald cut engagement rings at Wedding Day Diamonds in Minnesota Find sophistication and beauty in this timeless cut' %}
  {% elsif tab_word_tag == 'engagement-rings/Halo' %}
    {% assign page_title_custom = 'Halo Engagement Rings' %}
    {% assign page_description_custom = 'Envelop your center stone in brilliance with Wedding Day Diamonds halo engagement rings in Minnesota Discover exquisite designs that capture hearts' %}
  {% elsif tab_word_tag == 'earrings/Hoops' %}
    {% assign page_title_custom = 'Hoop Earrings' %}
    {% assign page_description_custom = 'Discover stunning hoop earrings at Wedding Day Diamonds Shop ethically sourced diamonds with local availability in Minnesota Find your perfect pair today!' %}
  {% elsif tab_word_tag == 'bracelets/Tennis' %}
    {% assign page_title_custom = 'Exquisite Tennis Bracelets: Sparkle with Elegance at Wedding Day Diamonds' %}
    {% assign page_description_custom = 'Discover stunning tennis bracelets at Wedding Day Diamonds Our ethically sourced diamonds shine bright, available locally in Minnesota Find your perfect piece today!' %} 
  {% elsif tab_word_tag == 'engagement-rings/Luxury' %}
    {% assign page_title_custom = 'Luxury Engagement Rings' %}
    {% assign page_description_custom = 'Discover an opulent collection of luxury engagement rings at Wedding Day Diamonds in Minnesota Find the epitome of sophistication and elegance' %}
  {% endif %}
{% endif %}
{% comment %} {% elsif tab_word_tag == 'engagement-rings/Luxury' %}
    {% assign page_title_custom = '' %}
    {% assign page_description_custom = '' %} {% endcomment %}



<title>
  {% if tab_word != blank and page_title_custom != blank %}
    {{ page_title_custom }}
  {% elsif tab_word_tag != blank and page_title_custom != blank %}
     {{ page_title_custom }}
  {% else %}
    {% if request.path contains '/apps/engagement-rings' %}
      {% assign page_title_custom = 'Engagement Rings in Minnesota | Wedding Day Diamonds' %}
      {{- page_title_custom -}}
    {%  else %}
      {{ page_title }}
    {% endif %}
  
   {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {% endif %}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>
{% if request.path contains '/apps/engagement-rings' %}
   {% assign page_description_custom_eng = 'Explore exquisite engagement rings in Minnesota at Wedding Day Diamonds. Find your perfect custom design or classic ring with our lifetime guarantee.' %}
{%  else %}
  {% assign page_description_custom_eng =  page_description %}
  {% endif %}
{% if request.path contains '/apps/engagement-rings' %}
   <meta
    name="description"
    content="{{ page_description_custom_eng }}"
  >
{% elsif page_description  %}
  <meta
    name="description"
    content="
    {% if tab_word != blank and page_description_custom != blank %}{{page_description_custom}}{% elsif tab_word_tag != blank and page_description_custom != blank %} {{page_description_custom}}{% elsif page_description_custom_eng != '' %}{{ page_description_custom_eng }}{% else %}{{ page_description | escape }}{% endif %}"
  >
  {% else %}
     <meta
    name="description"
    content="{{ og_description }}"
  >
{% endif %}
