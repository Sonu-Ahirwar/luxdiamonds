<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script> 


{% if block != blank %}
  {% assign block_settings = block.settings %}
{% else %}
  {% assign block_settings = settings %}
{% endif %}
{% comment %} <script src="{{ 'results-list.js' | asset_url }}" defer></script> {% endcomment %}

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
  {% assign enable_infinite_scroll =  section.settings.enable_infinite_scroll %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section product-grid-container color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style {{ section.settings.collection_custom_class }}"
  >
    {% if collection != blank %}
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}
    {% endif %}


    {% assign enable_infinite_scroll = section.settings.enable_infinite_scroll %}

    {% if enable_infinite_scroll %}
      {% assign products_per_page = 10 %}
    {% else %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}
    {% paginate collection.products by products_per_page %}
    {% capture children %}

    {% if section.settings.insert_after_positions != blank %}
      {% assign insert_positions = section.settings.insert_after_positions | split: ',' %}
    {% else %}
      {% assign insert_positions = '' | split: ',' %}
    {% endif %}

    {% if collection.products.size > 0 %}
        {% assign banner_enabled = false %}
        {% if section.settings.insert_image != blank and paginate.current_page == 1 %}
          {% assign banner_enabled = true %}
        {% endif %}

        {% assign display_products = products_per_page %}

        {% if banner_enabled %}
          {% assign display_products = products_per_page | minus: 1 %}
        {% endif %}
        {% assign products_list = collection.products | default: paginate.items %}
        {% for product in products_list limit: display_products %}

        {% if product and product.id %}
            {% if product == blank or product.id == blank %}
            {% continue %}
          {% endif %}

{% if product != blank and product.id != blank %}

  {% capture product_children %}
    {% content_for 'blocks', closest.product: product %}
  {% endcapture %}

  <li
    id="{{ section.id }}-{{ product.id }}"
    class="product-grid__item product-grid__item--{{ forloop.index0 }} wdd-card"
    data-page="{{ paginate.current_page }}"
    data-product-id="{{ product.id }}"
  >

{% content_for 'block',
  type: '_product-card',
  id: 'product-card',
  closest.product: product,
  page_current: paginate.current_page
%}

  </li>

{% endif %}
          

          {% assign current_index = forloop.index %}

            {% assign insert_positions_clean = section.settings.insert_after_positions | replace: ' ', '' %}

            {% assign insert_positions_string = ',' | append: insert_positions_clean | append: ',' %}

            {% assign current_position = ',' | append: current_index | append: ',' %}

            {% if insert_positions_string contains current_position %}

              {% if section.settings.insert_image != blank %}

                <li class="collection-custom-image">

                  {% if section.settings.insert_image_url != blank %}
                    <a href="{{ section.settings.insert_image_url }}">
                  {% endif %}

                   <picture>
                    {% if section.settings.insert_image_mobile != blank %}
                      <source media="(max-width: 749px)" srcset="{{ section.settings.insert_image_mobile | image_url: width: 900 }}">
                    {% endif %}
                    <img src="{{ section.settings.insert_image | image_url: width: 1200 }}" alt="{{ section.settings.insert_image_alt | escape }}" loading="lazy">
                  </picture>
                  {% comment %} <img
                    src="{{ section.settings.insert_image | image_url: width: 600 }}"
                    alt="Custom Insert Image"
                    loading="lazy"
                  > {% endcomment %}

                  {% if section.settings.insert_image_url != blank %}
                    </a>
                  {% endif %}

                </li>

              {% endif %}

            {% endif %}

        {% endif %}

      {% endfor %}
    {% endif %}

    {% endcapture %}

    {% render 'product-grid',
      section: section,
      children: children,
      products: collection.products,
      paginate: paginate,
      enable_infinite_scroll: enable_infinite_scroll
    %}
  {% endpaginate %}
  </div>
</results-list>

{% comment %} {% assign content = collection.metafields.custom.tag_base_content.value %}

<h2>{{ content.tag }}</h2>

<div class="wdd_collection_banner">
  
  <div class="wdd-unique-banner__image">
    <img src="{{ content.top_image | image_url }}">
  </div>

  <div class="wdd-unique-banner__content text-block">    
    <div class="wdd-unique-banner__desc rte-formatter spacing-style paragraph">
     {{ content.top_content | metafield_tag  }}
    </div>
  </div>

</div>
<h3>{{ content.faq_title }}</h3>

{% assign content = collection.metafields.custom.tag_base_content.value %}

{% for i in (1..10) %}
  {% assign q_key = 'faq' | append: i | append: '_question' %}
  {% assign a_key = 'faq' | append: i | append: '_answer' %}

  {% if content[q_key] != blank %}
    <h4>{{ content[q_key] }}</h4>
    <div>{{ content[a_key] | metafield_tag }}</div>
  {% endif %}
{% endfor %}

<img src="{{ content.image_faq | image_url }}"> {% endcomment %}

{% stylesheet %}
  .main-collection-grid {
    grid-column: var(--grid-column--mobile);

    @media screen and (min-width: 750px) {
      grid-column: var(--grid-column--desktop);
    }
  }

  .collection-wrapper {
    @media screen and (min-width: 750px) {
      grid-template-columns:
        1fr repeat(
          var(--centered-column-number),
          minmax(0, calc((var(--page-width) - var(--page-margin) * 2) / var(--centered-column-number)))
        )
        1fr;
    }
  }

  .collection-wrapper:has(.facets-block-wrapper--full-width),
  .collection-wrapper:has(.collection-wrapper--full-width) {
    @media screen and (min-width: 750px) {
      grid-column: 1 / -1;
      grid-template-columns:
        minmax(var(--page-margin), 1fr) repeat(
          var(--centered-column-number),
          minmax(0, calc((var(--page-width) - var(--page-margin) * 2) / var(--centered-column-number)))
        )
        minmax(var(--page-margin), 1fr);
    }
  }

  .collection-wrapper:has(.facets--vertical) .facets-block-wrapper--vertical:not(.hidden) ~ .main-collection-grid {
    @media screen and (min-width: 750px) {
      grid-column: var(--facets-vertical-col-width) / var(--full-width-column-number);
    }
  }

  .collection-wrapper:has(.facets-block-wrapper--vertical:not(#filters-drawer)):has(.collection-wrapper--full-width) {
    @media screen and (min-width: 750px) {
      grid-column: 1 / -1;
      grid-template-columns: 0fr repeat(var(--centered-column-number), minmax(0, 1fr)) 0fr;
    }
  }

  :is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile)
    [product-grid-view='default']
    .product-grid__card {
    @media screen and (max-width: 749px) {
      padding-inline-start: max(var(--padding-xs), var(--padding-inline-start));
      padding-inline-end: max(var(--padding-xs), var(--padding-inline-end));
    }
  }

  :is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile)
    [product-grid-view='mobile-single']
    .product-grid__card {
    @media screen and (max-width: 749px) {
      padding-inline-start: max(var(--padding-xs), var(--padding-inline-start));
      padding-inline-end: max(var(--padding-xs), var(--padding-inline-end));
    }
  }

  /* Make product media go edge-to-edge by using negative margins */
  :is(.collection-wrapper--full-width) .card-gallery,
  :is(.collection-wrapper--full-width-on-mobile) .card-gallery {
    @media screen and (max-width: 749px) {
      margin-inline-start: calc(-1 * max(var(--padding-xs), var(--padding-inline-start)));
      margin-inline-end: calc(-1 * max(var(--padding-xs), var(--padding-inline-end)));
    }
  }
{% endstylesheet %}

{% schema %}
{
