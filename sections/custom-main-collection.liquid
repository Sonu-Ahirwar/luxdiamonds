{% endschema %}

<script>
  document.addEventListener("DOMContentLoaded", function() {
  const buttons = document.querySelectorAll(".pdpfx-btn");
  const currentText = document.getElementById("pdpfx-metal-current");
  const mainImage = document.querySelector(".product__media img, .product-main-image img");

  buttons.forEach(btn => {
    btn.addEventListener("click", () => {
      buttons.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");

      const metal = btn.dataset.metal;
      if (currentText) currentText.textContent = metal.charAt(0).toUpperCase() + metal.slice(1);

      if (mainImage) {
        const baseSrc = mainImage.src.split("?")[0];
        const newSrc = baseSrc.replace(/(rose|platinum|yellow|white)/i, metal);
        mainImage.src = newSrc;
      }
    });
  });
});

</script>