{% comment %}
  Recently Viewed Products Section (No Wishlist Icon)
{% endcomment %}

<style>
  .recently-wrapper {
  padding: 40px 0px;
}
{% comment %} .recently-title h2 {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 200;
    text-transform: uppercase;
    line-height: 28px;
    letter-spacing: 4px;
    color: {{ section.settings.title_color }};
    margin-bottom: 20px;
} {% endcomment %}

.js-recentPdpBlock {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
}

@media(max-width: 768px) {
  .js-recentPdpBlock {
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
  }
}

.c-product {
    text-align: center;
    position: relative;
    height: max-content;
}

.c-product img {
  width: 100%;
  object-fit: contain;
}

.c-product h3 {
    font-size: 16px;
    font-weight: 100;
    margin-top: 18px;
    margin-bottom: 8px;
    letter-spacing: .2em;
    line-height: 22px;
}

.c-product p {
    font-size: 16px;
    font-weight: 100;
    color: #305854;
    margin-top: 0px;
    letter-spacing: .2em;
    line-height: 22px;
    margin-bottom: 8px;
}

.js-recentPdpBlock .c-product a.recently_view_img{
    position: relative;
    display: flex;
    padding-bottom: 5px;

}

.js-recentPdpBlock .c-product a.recently_view_img:before {
    {% comment %} position: absolute;
    content: "";
    width: 100%;
    height: 100%;
    background-color: #000 !important;
    top: 0;
    left: 0; {% endcomment %}

    background: #000;
    content: "";
    height: 100%;
    left: 0;
    opacity: 0.02;
    position: absolute;
    right: 0;
    top: 0;
    width: 100%;
    z-index: 10;
}
</style>
<div class="section section--page-width">
<div class="recently-wrapper">
  <div class="recently-title">
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="js-recentPdpBlock"></div>
</div>
</div>
<script>
(function () {

  const STORAGE_KEY = "recently_viewed";
  const LIMIT = {{ section.settings.limit }};

  /* ===============================
     ADD PRODUCT
  ============================== */
  function addToRecentlyViewed() {

    const productTags = {{ product.tags | json }};

    // ❌ Skip configurator child
    if (productTags.includes('is_configurator_child')) return;

    const productData = {
      productUrl: "{{ product.url }}",
      productImg: "{{ product.featured_image | img_url: '400x' }}",
      productTitle: "{{ product.title | escape }}",
      productPrice: "{{ product.price | money }}",
      productTags: productTags
    };

    let stored = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];

    // 🔁 Remove duplicate
    stored = stored.filter(item => item.productUrl !== productData.productUrl);

    // ⬆️ Add latest at top
    stored.unshift(productData);

    // ✂️ Limit
    stored = stored.slice(0, LIMIT);

    localStorage.setItem(STORAGE_KEY, JSON.stringify(stored));
  }

  /* ===============================
     BUILD HTML
  ============================== */
  function getRecentPdp() {

    const container = document.querySelector(".js-recentPdpBlock");
    if (!container) return;

    const pdpData = JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];

    const currentProductUrl = "{{ product.url }}";

    // 🔥 FILTER
    const filteredData = pdpData.filter(item => {
      return (
        item.productUrl !== currentProductUrl &&
        !(item.productTags && item.productTags.includes('is_configurator_child'))
      );
    });

    let html = "";

    filteredData.forEach(item => {
      html += `
        <div class="c-product">
          <a href="${item.productUrl}" class="recently_view_img">
            <img src="${item.productImg}" alt="${item.productTitle}">
          </a>

          <a href="${item.productUrl}" class="contents user-select-text card_productTitle">
            <p>${item.productTitle}</p>
          </a>

          <p>${item.productPrice}</p>
        </div>
      `;
    });

    container.innerHTML = html;

    // ✅ INIT SLIDER (mobile only)
    setTimeout(function () {
      if (window.innerWidth <= 991) {
        initRecentSlider();
      }
    }, 50);
  }

  /* ===============================
     SLICK SLIDER
  ============================== */
  function initRecentSlider() {

    const $slider = $('.js-recentPdpBlock');
    if (!$slider.length || $slider.length < 3) return;

    const totalSlides = $slider.children('.c-product').length;
    const isMobile = window.innerWidth <= 991;

    if (isMobile) {

      if (!$slider.hasClass('slick-initialized')) {
        $slider.slick({
          slidesToShow: 3,
          slidesToScroll: 1,
          arrows: false,
          dots: totalSlides > 3,
          infinite: totalSlides > 3,
          responsive: [
            {
              breakpoint: 767,
              settings: {
                slidesToShow: 2,
                dots: totalSlides > 2
              }
            }
          ]
        });
      }

    } else {

      if ($slider.hasClass('slick-initialized')) {
        $slider.slick('unslick');
      }

    }
  }

  /* ===============================
     INIT
  ============================== */
  document.addEventListener("DOMContentLoaded", function () {
    addToRecentlyViewed();
    getRecentPdp();
  });

  /* ===============================
     RESPONSIVE REBUILD
  ============================== */
  let resizeTimer;

  window.addEventListener("resize", function () {
    clearTimeout(resizeTimer);

    resizeTimer = setTimeout(function () {
      initRecentSlider();
    }, 300);
  });

})();
</script>

{% schema %}
{
  "name": "Custom Recently Viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    },
    {
      "type": "number",
      "id": "limit",
      "label": "Number of products to show",
      "default": 4
    },
    {
      "type": "number",
      "id": "top_margin",
      "label": "Top margin (px)",
      "default": 40
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#395754"
    },
    {
      "type": "number",
      "id": "title_size",
      "label": "Heading Font Size (px)",
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "Custom Recently Viewed"
    }
  ]
}
{% endschema %}
