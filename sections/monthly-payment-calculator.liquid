{% comment %}
  Calculate Monthly Payment – Luxury Style
{% endcomment %}

<section id="calculator-{{ section.id }}" class="lux-calculator">
  <div class="lux-wrap">
    <h2 class="lux-title">{{ section.settings.heading }}</h2>

    <div class="lux-box">
      <form class="fina_calc_form">

        <div class="form_group">
          <label for="fina_est_price">Total Purchase Price</label>
          <div class="input_group">
            <span>$</span>
            <input type="text" id="fina_est_price" placeholder="3000.00">
          </div>
        </div>

        <div class="form_group">
          <label for="fina_est_term">Term Length</label>
          <div class="select_input_group">
            <select id="fina_est_term">
              <option value="">Please Select</option>
              {% for block in section.blocks %}
                {% if block.type == 'term' %}
                  <option value="{{ block.settings.months }}">{{ block.settings.months }} months</option>
                {% endif %}
              {% endfor %}
            </select>
          </div>
        </div>

        <div class="form_group">
          <label for="fina_est_apr">Estimated APR</label>
          <div class="select_input_group">
            <select id="fina_est_apr">
              <option value="">Please Select</option>
              {% for block in section.blocks %}
                {% if block.type == 'apr' %}
                  <option value="{{ block.settings.rate }}">{{ block.settings.rate }}%</option>
                {% endif %}
              {% endfor %}
            </select>
          </div>
        </div>

        <div class="form_group">
          <button id="fina_est_calc_btn" class="lux-btn">
            {{ section.settings.btn_text }}
          </button>
        </div>

        <div class="form_group">
          <label for="fina_est_result">Estimated Monthly Payment</label>
          <div class="input_group">
            <span>$</span>
            <input type="text" id="fina_est_result" placeholder="200.00" readonly>
          </div>
        </div>

        <div class="form_group">
          <a href="#" id="reset-{{ section.id }}" class="lux-reset"> START OVER </a>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  #calculator-{{ section.id }}{
    padding: {{ section.settings.padding }}px 20px;
    background: {{ section.settings.bg }};
  }

  #calculator-{{ section.id }} .lux-wrap{
    max-width: {{ section.settings.max_width }}px;
    margin: auto;
    text-align: center;
  }

  #calculator-{{ section.id }} .lux-title{
    letter-spacing: 3px;
    font-size: {{ section.settings.heading_size }}px;
    margin-bottom: 50px;
  }

  #calculator-{{ section.id }} .lux-box{
    border: 1px solid #ececec;
    padding: 48px 0px;
    background-color:#fafaf9;
  }
  form.fina_calc_form {
    width: 100%;
    max-width: 330px;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .fina_calc_form label{
    display: block;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 2px;
    color:#395754;
    margin-bottom:8px;
  }

  .fina_calc_form input,
  .fina_calc_form select{
    width: 100%;
    height: auto;
    padding: .375rem .75rem;
    border: 1px solid #728080;
    background: transparent;
    font-size: 15px;
    letter-spacing: 2px;
    color:#728080;
    font-weight: 200;
    line-height: 1.5;
    border-radius:5px;
  }
  .fina_calc_form input{
    padding-left: 28px;
  }
  .fina_calc_form input::placeholder{
    color:#728080;
  }
  .fina_calc_form .input_group,
  .fina_calc_form .select_input_group{
    position:relative;
  }
  .fina_calc_form .input_group span{
    position:absolute;
    color: #395754;
    font-weight: 500;
    width: 30px;
    top: 50%;
    left: 0px;
    transform: translateY(-50%);
  }
  .fina_calc_form input:focus-visible,
  .fina_calc_form select:focus-visible{
    outline: none;
    outline-offset: unset;
  }
  .fina_calc_form select{
   -webkit-appearance: none;
    appearance: none;
    background-clip: padding-box;
    transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
    width: 100%;
    cursor:pointer;
    position: relative;
    z-index: 2;
  }
  .fina_calc_form .select_input_group::after{
    content: "";
    display: inline-block;
    height: 8px;
    position: absolute;
    right: 11px;
    text-decoration: none;
    text-indent: -9999px;
    top: 12px;
    -webkit-transform: rotate(-135deg);
    transform: rotate(-135deg);
    transition: all .25s ease-in-out;
    width: 8px;
    border-left: 1px solid #000;
    border-right: none;
    border-top: 1px solid #000;
  }

  .fina_calc_form .lux-btn{
    width: 100%;
    background: #395754;
    border: 2px solid #395754;
    border-radius: 10px;
    color: #fff;
    font-size: 16px;
    font-family: "Open Sans", sans-serif;
    font-weight: 500;
    letter-spacing: 5px;
    margin: 25px 0px 20px;
    padding: 12px 0;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.6s;
  }
  .fina_calc_form .lux-btn:hover{
    background: #9cadab;
    border: 2px solid #9cadab;
  }
  .fina_calc_form .lux-btn[disabled]{
    opacity:0.5;
  }
  .fina_calc_form .lux-reset{
    display: inline-block;
    margin-top: 24px;
    font-size: 14px;
    letter-spacing: 2px;
    color: #6b7363;
    font-weight: 500;
    text-decoration: underline;
    text-transform: uppercase;
  }

  @media(max-width: 749px){
    #calculator-{{ section.id }}{
      padding: {{ section.settings.padding | times: 0.5 }}px 12px;
    }
    #calculator-{{ section.id }} .lux-title{
      font-size: 20px;
    }
    .fina_calc_form .lux-btn{
      font-size: 13px;
      letter-spacing: 2.5px;
      margin: 20px auto 15px;
      padding: 11px;
    }
  }
</style>

{% comment %} <script>
  (function () {
    const price = document.getElementById('price-{{ section.id }}');
    const term = document.getElementById('term-{{ section.id }}');
    const apr = document.getElementById('apr-{{ section.id }}');
    const result = document.getElementById('result-{{ section.id }}');

    document.getElementById('calc-{{ section.id }}').onclick = function () {
      const p = parseFloat(price.value);
      const t = parseInt(term.value);
      const a = parseFloat(apr.value || 0) / 100 / 12;

      if (!p || !t) return;

      let m;
      if (a === 0) {
        m = p / t;
      } else {
        m = (p * a) / (1 - Math.pow(1 + a, -t));
      }
      result.value = '$ ' + m.toFixed(2);
    };

    document.getElementById('reset-{{ section.id }}').onclick = function (e) {
      e.preventDefault();
      price.value = '';
      term.value = '';
      apr.value = '';
      result.value = '';
    };
  })();
</script> {% endcomment %}

<script>
  document.addEventListener("DOMContentLoaded", function () {

    const priceInput = document.getElementById("fina_est_price");
    const termSelect = document.getElementById("fina_est_term");
    const aprSelect = document.getElementById("fina_est_apr");
    const resultInput = document.getElementById("fina_est_result");
    const calcBtn = document.getElementById("fina_est_calc_btn");
    const resetBtn = document.querySelector(".lux-reset");

    calcBtn.disabled = true;

    priceInput.addEventListener("input", function () {
      this.value = this.value.replace(/[^0-9.]/g, "");
      checkForm();
    });

    termSelect.addEventListener("change", checkForm);
    aprSelect.addEventListener("change", checkForm);

    function checkForm() {
      if (
        priceInput.value.trim() !== "" &&
        termSelect.value !== "" &&
        aprSelect.value !== ""
      ) {
        calcBtn.disabled = false;
      } else {
        calcBtn.disabled = true;
      }
    }

    calcBtn.addEventListener("click", function (e) {
      e.preventDefault();

      const price = parseFloat(priceInput.value);
      const months = parseInt(termSelect.value);
      const apr = parseFloat(aprSelect.value);

      const monthlyRate = apr / 100 / 12;
      let monthlyPayment;

      if (apr === 0) {
        monthlyPayment = price / months;
      } else {
        monthlyPayment =
          (price * monthlyRate) /
          (1 - Math.pow(1 + monthlyRate, -months));
      }

      resultInput.value = monthlyPayment.toFixed(2);
    });

    resetBtn.addEventListener("click", function (e) {
      e.preventDefault();

      priceInput.value = "";
      termSelect.value = "";
      aprSelect.value = "";
      resultInput.value = "";

      calcBtn.disabled = true;
    });

  });
</script>


{% schema %}
{
  "name": "Calculate Monthly Payment",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "CALCULATE MONTHLY PAYMENT" },
    { "type": "range", "id": "heading_size", "label": "Heading Size", "min": 18, "max": 36, "step": 1, "default": 24 },
    { "type": "range", "id": "max_width", "label": "Box Width", "min": 420, "max": 800, "step": 20, "default": 560 },
    { "type": "range", "id": "padding", "label": "Section Padding", "min": 40, "max": 120, "step": 10, "default": 80 },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "CALCULATE" },
    { "type": "color", "id": "btn_bg", "label": "Button Color", "default": "#9aa7a3" }
  ],
  "blocks": [
    {
      "type": "term",
      "name": "Term Length",
      "settings": [{ "type": "number", "id": "months", "label": "Months", "default": 12 }]
    },
    {
      "type": "apr",
      "name": "APR Rate",
      "settings": [{ "type": "number", "id": "rate", "label": "APR %", "default": 0 }]
    }
  ],
  "presets": [{ "name": "Monthly Payment Calculator" }]
}
{% endschema %}
