{% style %}
    @media screen and (min-width:1200px){
        .bracelet-block__title {
            font-size: 1.75rem;
        }
    }
    .bracelet-styles {
        padding-top: 80px;
        padding-bottom: 100px;
        background-color:#f8f9fa;
    }
    .bracelet-styles__container {
        width:100%;
        max-width: 1320px;
        margin: 0 auto;
    }
    .bracelet-styles__header {
        text-align: center;
        margin-bottom: 48px;
    }
    .bracelet-styles__title {
        font-size: 25px;
        color: #395754;
        font-weight: 600;
        letter-spacing: 1px;
        margin-bottom: 12px;
        text-transform: uppercase;
    }
    .bracelet-styles__desc p{
        font-size: 16px;
        color: #728080;
        letter-spacing: 1px;
        line-height: 28px;
        margin-bottom: 0px;
    }
    .bracelet-styles__grid {
        display: grid;
        gap: 24px;
        grid-template-columns: 1fr 1fr;
        align-items: flex-start;
    }
    .bracelet-styles--right .bracelet-styles__image { order: 2; }
    .bracelet-styles--right .bracelet-styles__content { order: 1; }

    .bracelet-block {
        margin-bottom: 28px;
    }
    .bracelet-block__title {
        font-size: 20px;
        color: #395754;
        font-weight: 600;
        letter-spacing: 1px;
        margin-bottom: 12px;
        text-transform: uppercase;
    }
    .bracelet-block__desc p{
        font-size: 16px;
        color: #728080;
        letter-spacing: 1px;
        line-height: 28px;
        margin-bottom: 20px;
    }
    .bracelet-styles__image img {
        width: auto;
        height: auto;
        margin:0 auto;
    }
    @media screen and  (max-width: 1400px){
        .bracelet-styles__container {
            max-width: 1140px;
        }
    }
    @media screen and  (max-width: 1199px){
        .bracelet-styles__container {
            max-width: 960px;
        }
    }
    @media screen and  (max-width: 991px){
        .bracelet-styles__container{
            max-width: 720px;
            padding-inline:15px;
        }
       .bracelet-styles {
            padding-top: 48px;
            padding-bottom: 48px;
        }
        .bracelet-styles__grid {
            grid-template-columns: 1fr;
            gap:0px;
        }
    }
    @media screen and (max-width: 749px) {
        .bracelet-styles__grid {
            text-align:center;
        }
        .bracelet-styles--right .bracelet-styles__image {
            display: none;
        }
    }
{% endstyle %}

<div class="bracelet-styles bracelet-styles--{{ section.settings.image_position }} {{ section.settings.custom_class }}">
  <div class="bracelet-styles__container">

    <!-- Header -->
    <div class="bracelet-styles__header">

      {% if section.settings.title != blank %}
        <h2 class="bracelet-styles__title">
          {{ section.settings.title }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="bracelet-styles__desc">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </div>

    <!-- Main Grid -->
    <div class="bracelet-styles__grid">

      <!-- LEFT: Text Blocks -->
      <div class="bracelet-styles__content">

        {% for block in section.blocks %}
          <div class="bracelet-block" {{ block.shopify_attributes }}>

            {% if block.settings.heading != blank %}
              <h3 class="bracelet-block__title">
                {{ block.settings.heading }}
              </h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="bracelet-block__desc">
                {{ block.settings.text }}
              </div>
            {% endif %}

          </div>
        {% endfor %}

      </div>

      <!-- Right: Image -->
      <div class="bracelet-styles__image">

        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy" width="" height=""
          >
        {% endif %}

      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Bracelet Styles Guide",
  "disabled_on": { 
    "groups": ["header", "footer"] 
  },
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Intro Description"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    }
  ],

  "blocks": [
    {
      "type": "text_block",
      "name": "Content Block",
      "settings": [

        {
          "type": "text",
          "id": "heading",
          "label": "Block Heading"
        },

        {
          "type": "richtext",
          "id": "text",
          "label": "Block Description"
        }

      ]
    }
  ],

  "presets": [
    {
      "name": "Bracelet Styles Guide"
    }
  ]
}
{% endschema %}