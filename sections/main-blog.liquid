<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<div class="blog-tabs">
  <a href="{{ blog.url }}" class="{% if current_tags == blank %}active{% endif %}">
    ALL POSTS
  </a>

  {% assign tabs = "Wedding,Engagement,Lab Grown Diamonds,Jewelry,Men's Corner" | split: "," %}

  {% for tag in tabs %}
    <a 
      href="{{ blog.url }}/tagged/{{ tag | handleize }}"
      class="{% if current_tags contains tag %}active{% endif %}">
      {{ tag }}
    </a>
  {% endfor %}
</div>
<style>
.blog-tabs {
    display: flex;
    gap: 60px;
    justify-content: center;
    font-weight: 200;
    letter-spacing: .2em;
    padding: 40px 12px 60px;
    text-transform: uppercase;
}
.spacing-style.text-block {
    font-size: 26px;
    letter-spacing: 0;
}
.blog-tabs a {
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 1px;
    color: #000;
    position: relative;
}
.blog-tabs a.active {
    color: #395754;
}

.spacing-style.text-block.text-block--AK2JPSmVsNStTM0Ztc__title.h2 {
    display: none;
}

/* MOBILE SCROLL FIX */
@media screen and (max-width: 749px) {

 .blog-tabs {
    overflow-x: auto;
    overflow-y: hidden;
    flex-wrap: nowrap;
    justify-content: flex-start;
    gap: 30px;
    padding: 20px 12px;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    margin-bottom: 20px;
}

  .blog-tabs::-webkit-scrollbar {
    display: none; /* hide scrollbar */
  }

  .blog-tabs a {
    white-space: nowrap; /* 🔥 keep text in one line */
    flex: 0 0 auto; /* prevent shrinking */
  }
}

@media (min-width: 768px) and (max-width: 991px) {
.spacing-style.text-block {
    font-size: 17px;
    letter-spacing: 0;
}
.blog-tabs {
    overflow-x: auto;
    overflow-y: hidden;
    flex-wrap: nowrap;
    justify-content: flex-start;
    gap: 25px;
    padding: 20px 12px;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    margin-bottom: 20px;
}
.blog-tabs a {
    white-space: nowrap;
    flex: 0 0 auto;
}
}
</style>

<blog-posts-list section-id="{{ section.id }}">
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="
      section
      color-{{ section.settings.color_scheme }}
      blog-posts
      spacing-style
      size-style
    "
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    {%- paginate blog.articles by 12 -%}
      <span ref="viewMorePrevious"></span>
      <div
        ref="grid"
        class="blog-posts-container"
        data-last-page="{{ paginate.pages }}"
      >
        {% for article in blog.articles %}
          <div
            class="blog-post-item"
            ref="cards[]"
            data-page="{{ paginate.current_page }}"
          >
            {% content_for 'block', id: 'static-blog-post-card', type: '_blog-post-card', article: article, fallback_image: section.settings.fallback_image %}
          </div>
        {% endfor %}
      </div>
      <span ref="viewMoreNext"></span>
    {%- endpaginate -%}
  </div>
</blog-posts-list>

{% stylesheet %}
  /**
   * Blog posts page layout
   */
  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    --columns-gap: 36px;
    --rows-gap: 36px;
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
    max-width: 980px;
    margin: 0 auto;
  }

  /**
   * Apart from the first and second rows in the grid, all remaining blog posts
   * are arranged in a three-column layout:
   * +------------+------------+-------------+
   * |            |            |             |
   * |  (span 2)  |  (span 2)  |  (span 2)   |
   * |            |            |             |
   * +------------+------------+-------------+
   */
  .blog-post-item {
    --blog-post-card-scale: 0.6;

    grid-column: span 2;

    @media screen and (max-width: 749px) {
      --blog-post-card-scale: 0.5;

      grid-column: span 6;
    }
  }

  /**
   * The second row of blog posts has two columns:
   * +-------------------+-------------------+
   * |                   |                   |
   * |  (column span 3)  |  (column span 3)  |
   * |                   |                   |
   * +-------------------+-------------------+
   */
  /* .blog-post-item:nth-child(2),
  .blog-post-item:nth-child(3) {
    --blog-post-card-scale: 0.8;

    grid-column: span 3;

    @media screen and (max-width: 749px) {
      --blog-post-card-scale: 0.5;

      grid-column: span 6;
    }
  } */

  /**
   * The first row of blog posts has only one column:
   * +---------------------------------------+
   * |                                       |
   * |           (1 column span 6)           |
   * |                                       |
   * +---------------------------------------+
   */
  /* .blog-post-item:first-child {
    --blog-post-card-scale: 1;

    grid-column: span 6;
  } */

  /**
   * When there's no image, the blog post item has a border.
   */
  .blog-post-item {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding: 0 1rem 1rem;
  }

  .blog-post-item:has(.blog-post-card__image-container) {
    border: none;
    padding: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
