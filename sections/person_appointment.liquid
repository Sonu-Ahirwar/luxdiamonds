    color: #b42318;
    border: 1px solid #f5c2c0;
  }

  .submit-btn[disabled] {
    opacity: 0.7;
    cursor: not-allowed;
  }
</style>

<script>
flatpickr("#datePicker", {
    dateFormat: "d-m-Y",
    disable: [
        function(date) {
            // Disable Sunday
            if (date.getDay() === 0) {
                return true;
            }

            // Disable 7 September
            if (date.getDate() === 7 && date.getMonth() === 8) {
                return true;
            }

            return false;
        }
    ],
    onChange: function(selectedDates) {
        const selectedDate = selectedDates[0];
        if (!selectedDate) return;

        const day = selectedDate.getDay(); // 6 = Saturday
        const timeDropdown = document.getElementById("inPersonTime");

        // Clear old options
        timeDropdown.innerHTML = '<option value="">Choose a Time</option>';

        let timeSlots = [];

        if (day === 6) {
            // Saturday → 10 AM to 6 PM
            timeSlots = [
                "10:00 am - 11:00 am",
                "11:00 am - 12:00 pm",
                "12:00 pm - 1:00 pm",
                "1:00 pm - 2:00 pm",
                "2:00 pm - 3:00 pm",
                "3:00 pm - 4:00 pm",
                "4:00 pm - 5:00 pm",
                "5:00 pm - 6:00 pm"
            ];
        } else {
            // Other days → 11 AM to 7 PM
            timeSlots = [
                "11:00 am - 12:00 pm",
                "12:00 pm - 1:00 pm",
                "1:00 pm - 2:00 pm",
                "2:00 pm - 3:00 pm",
                "3:00 pm - 4:00 pm",
                "4:00 pm - 5:00 pm",
                "5:00 pm - 6:00 pm",
                "6:00 pm - 7:00 pm"
            ];
        }

        // Add new options
        timeSlots.forEach(slot => {
            const option = document.createElement("option");
            option.value = slot;
            option.textContent = slot;
            timeDropdown.appendChild(option);
        });
    }
});

  (function () {

  // Helper function to format DD-MM-YYYY to MM/DD/YYYY
  function formatToMMDDYYYY(dateStr) {
    if (!dateStr) return "";
    const parts = dateStr.split("-");
    if (parts.length === 3) {
      const day = parts[0];
      const month = parts[1];
      const year = parts[2];
      return `${month}/${day}/${year}`;
    }
    return dateStr;
  }

  function initForm(scope) {
    const form = (scope || document).querySelector("#appointmentInPersonForm_person");
    if (!form || form.dataset.bound === "true") return;

    form.dataset.bound = "true";

    const submitBtn = form.querySelector("#appointmentInPersonSubmitBtn_person");
    const messageBox = form.querySelector("#appointmentInPersonFormMessage_person");

    function showMessage(text, type) {
      messageBox.style.display = "block";
      messageBox.textContent = text;
      messageBox.className = "form-message " + type;
    }

    function clearMessage() {
      messageBox.style.display = "none";
      messageBox.textContent = "";
      messageBox.className = "form-message";
    }

    async function handleSubmit(e) {
      e.preventDefault();
      clearMessage();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const fd = new FormData(form);

      const payload = {
        appointmentType: "in_person",
        reasonForVisit: fd.get("reasonForVisit"),
        firstName: fd.get("firstName")?.trim(),
        lastName: fd.get("lastName")?.trim(),
        email: fd.get("email")?.trim(),
        phone: fd.get("phone")?.trim(),
        shape: fd.get("shape") || null,
        carat: fd.getAll("carat"),
        budget: fd.get("budget") || null,
        additionalDetails: fd.get("additionalDetails") || "",
        location: fd.get("location"),
        date: formatToMMDDYYYY(fd.get("date")),
        time: fd.get("time")
      };

      if (
        !payload.reasonForVisit ||
        !payload.firstName ||
        !payload.lastName ||
        !payload.email ||
        !payload.phone ||
        !payload.location ||
        !payload.date ||
        !payload.time
      ) {
        showMessage("Please fill all required fields.", "error");
        return;
      }

      try {
        submitBtn.disabled = true;
        submitBtn.textContent = "Submitting...";

        const response = await fetch("/apps/custom-forms/appointment-in-person", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (response.ok && result.success) {
          showMessage("Your in-person appointment request has been submitted successfully.", "success");
          form.reset();
        } else {
          showMessage(result.message || "Something went wrong.", "error");
        }
      } catch (error) {
        console.error(error);
        showMessage("Unable to submit the form right now.", "error");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "SCHEDULE";
      }
    }

    form.addEventListener("submit", handleSubmit);
  }
  document.addEventListener("DOMContentLoaded", function () {
    initForm(document);
  });
  document.addEventListener("shopify:section:load", function (e) {
    initForm(e.target);
  });

})();
</script>