<script>
(function () {
  function initCustomInquiryForm(scope) {
    const form = (scope || document).querySelector("#customInquiryForm");
    if (!form || form.dataset.bound === "true") return;

    form.dataset.bound = "true";

    const submitBtn = form.querySelector("#customInquirySubmitBtn");
    const messageBox = form.querySelector("#customInquiryFormMessage");

    function showMessage(text, type) {
      if (!messageBox) return;
      messageBox.style.display = "block";
      messageBox.textContent = text;
      messageBox.className = "form-message " + type;
    }

    function clearMessage() {
      if (!messageBox) return;
      messageBox.style.display = "none";
      messageBox.textContent = "";
      messageBox.className = "form-message";
    }

    async function handleSubmit(e) {
      e.preventDefault();
      e.stopPropagation();
      clearMessage();

      if (submitBtn && submitBtn.disabled) return false;

      const fd = new FormData(form);

      const payload = {
        inquiryType: "custom_inquiry",
        firstName: fd.get("firstName"),
        lastName: fd.get("lastName"),
        email: fd.get("email"),
        phone: fd.get("phone"),
        comment: fd.get("comment") || "",
        location: fd.get("location"),
        date: fd.get("date") || "",
        time: fd.get("time") || ""
      };

      if (
        !payload.firstName ||
        !payload.lastName ||
        !payload.email ||
        !payload.phone ||
        !payload.location
      ) {
        showMessage("Please fill all required fields.", "error");
        return false;
      }

      try {
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Submitting...";
        }

        const response = await fetch("/apps/custom-forms/custom-inquiry", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (response.ok && result.success) {
          showMessage("Your custom inquiry has been submitted successfully.", "success");
          form.reset();
        } else {
          showMessage(result.message || "Something went wrong. Please try again.", "error");
        }
      } catch (error) {
        console.error("Custom inquiry submit error:", error);
        showMessage("Unable to submit the form right now. Please try again later.", "error");
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Schedule";
        }
      }

      return false;
    }

    form.addEventListener("submit", handleSubmit, true);
  }

  document.addEventListener("DOMContentLoaded", function () {
    initCustomInquiryForm(document);
  });

  document.addEventListener("shopify:section:load", function (event) {
    initCustomInquiryForm(event.target);
  });
})();
</script>

