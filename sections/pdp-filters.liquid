  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const shareLi = document.querySelector('.share-toggle');
      if (!shareLi) return;

      const iconBox = shareLi.querySelector('.socialmediaIconBox');
      const buttons = iconBox.querySelectorAll('button');

      // 🔐 LOCK URL ON PAGE LOAD (THIS FIXES BLANK WINDOW ISSUE)
      const PAGE_URL = encodeURIComponent(
        document.querySelector('link[rel="canonical"]')?.href || window.location.href
      );

      /* ---------------- TOGGLE SHARE BOX ---------------- */
      shareLi.addEventListener('click', function (e) {
        shareLi.classList.toggle('active');
        if (e.target.closest('button')) return;
        iconBox.classList.toggle('active');
      });

      /* ---------------- SHARE HANDLERS ---------------- */
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();

          let shareUrl = '';

          switch (btn.getAttribute('data-share')) {
            case 'facebook':
              shareUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + PAGE_URL;
              break;

            case 'twitter':
              shareUrl = 'https://twitter.com/intent/tweet?url=' + PAGE_URL;
              break;

            case 'pinterest':
              shareUrl = 'https://pinterest.com/pin/create/button/?url=' + PAGE_URL;
              break;

            case 'email':
              shareUrl = 'mailto:?subject=Check this out&body=' + PAGE_URL;
              break;
              
          }
          if (!shareUrl) return;
         
          

          window.open(shareUrl, '_blank', 'noopener,noreferrer,width=600,height=500');

          // Optional: auto close after click
          iconBox.classList.remove('active');
          shareLi.classList.remove('active');
        });
      });

      /* ---------------- CLICK OUTSIDE CLOSE ---------------- */
      document.addEventListener('click', function (e) {
        if (!shareLi.contains(e.target)) {
          iconBox.classList.remove('active');
          shareLi.classList.remove('active');
        }
      });
    });
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const modal_outer = document.querySelector('.modal-backdrop');

      const send_hint_btn = document.querySelector('.send_hint_btn');
      const send_hint_modal = document.querySelector('.send_hint.main.modal');

      const appointment_btn = document.querySelector('.appointment_box');
      const appointment_modal = document.querySelector('.BookAppointment_modal.modal');

      const close_buttons = document.querySelectorAll('.sent-hint-close');

      // -------- OPEN SEND HINT MODAL --------
      if (send_hint_btn && send_hint_modal) {
        send_hint_btn.addEventListener('click', function (e) {
          e.preventDefault();
          modal_outer.classList.add('show');
          send_hint_modal.classList.add('show');
        });
      }

      // -------- OPEN APPOINTMENT MODAL --------
    if (appointment_btn && appointment_modal) {

        appointment_btn.addEventListener('click', function (e) {
          e.preventDefault();

          // Open modal
          modal_outer.classList.add('show');
          appointment_modal.classList.add('show');

          // Get current URL
          var currentUrl = window.location.href;

          // Set URL inside .additional_note
          var noteField = appointment_modal.querySelector('.additional_note');

          if (noteField) {
            if (noteField.tagName === 'INPUT' || noteField.tagName === 'TEXTAREA') {
              noteField.value = currentUrl;
            } else {
              noteField.textContent = currentUrl;
            }
          }
        });

      }


      // -------- CLOSE MODALS --------
      close_buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          modal_outer.classList.remove('show');

          send_hint_modal?.classList.remove('show');
          appointment_modal?.classList.remove('show');
        });
      });

      // -------- CLICK BACKDROP TO CLOSE --------
      if (modal_outer) {
        modal_outer.addEventListener('click', function () {
          modal_outer.classList.remove('show');

          send_hint_modal?.classList.remove('show');
          appointment_modal?.classList.remove('show');
        });
      }
    });
  </script>

