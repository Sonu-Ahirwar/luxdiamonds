{%- liquid
  assign fields = 'custom_all_skus,custom_all_skus_1,custom_all_skus_2,custom_all_skus_3,custom_all_skus_4,custom_all_skus_5' | split: ','
  assign mf_items = '' | split: ','

  for f in fields
    assign m = product.metafields.custom[f]
    if m != blank and m.value != blank
      assign mf_items = mf_items | concat: m.value
    endif
  endfor

  assign mf = mf_items
  if mf != blank
   assign mf = mf
  endif
-%}
{% assign custom_design = false %}
{% for col in product.collections %}
  {% if col.handle == 'custom-design' %}
    {% assign custom_design = true %}
  {% endif %}
{% endfor %}
<script>
  window.__PARENT_PRODUCT_ID__ = {{ product.id }};
  window.__PARENT_HANDLE__ = {{ product.handle | json }};
  window.__CUSTOMER_ID__ = {% if customer %}{{ customer.id | json }}{% else %}null{% endif %};
  window.__PDP_FALLBACK_VARIANT_ID__ = 48110669693149;
</script>
