{% style %}
    #category-grid--{{ section.id }}.category-grid {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    #category-grid--{{ section.id }} .category-grid__container {
        max-width: {{ section.settings.page_width }}px;
        margin: 0 auto;
        text-align: {{ section.settings.text_align }};
    }
    #category-grid--{{ section.id }} .category-grid__grid {
        display: grid;
        grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
        gap: {{ section.settings.gap }}px;
    }

    @media screen and (max-width: 1199px) {
        #category-grid--{{ section.id }} .category-grid__container {
            max-width: 960px;
        }
    }
    @media screen and (max-width: 992px) {
        #category-grid--{{ section.id }} .category-grid__container {
            max-width: 720px;
        }
        #category-grid--{{ section.id }} .category-grid__grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media screen and (max-width: 749px) {
        #category-grid--{{ section.id }} .category-grid__container {
            padding-inline:15px;
        }
        #category-grid--{{ section.id }} .category-grid__grid {
            grid-template-columns: 1fr;
            gap: 0px;
        }
    }

{% endstyle %}

<div class="category-grid {{ section.settings.custom_class }}" id="category-grid--{{ section.id }}">
  <div class="category-grid__container">

    {% if section.settings.heading != blank %}
      <h2 class="category-grid__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="category-grid__desc">
        {{ section.settings.description }}
      </div>
    {% endif %}

    <div class="category-grid__grid">

      {% for block in section.blocks %}
        <div class="category-grid__item" {{ block.shopify_attributes }}>

          {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.image.alt | escape }}"
                loading="lazy" width="" height=""
              >
          {% endif %}

          {% if block.settings.title != blank %}
            <a
              href="{{ block.settings.link }}"
              class="category-grid__title"
              {% if block.settings.new_tab %}target="_blank"{% endif %}
            >
              {{ block.settings.title }}
            </a>
          {% endif %}

        </div>
      {% endfor %}

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Custom Category Grid",

  "disabled_on": { 
    "groups": ["header", "footer"] 
  },
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (Desktop)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Grid Gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Page Width",
      "min": 900,
      "max": 2000,
      "step": 20,
      "default": 1320
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40
    }
  ],

  "blocks": [
    {
      "type": "item",
      "name": "Category Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Custom Category Grid"
    }
  ]
}
{% endschema %}