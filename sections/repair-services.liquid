{% comment %}
  Repair Services – Fully Customizable Section
{% endcomment %}

<section id="repair-{{ section.id }}" class="repair-services">
  <div class="repair-container">
    <div class="repair-header">
      {% if section.settings.show_icon %}
        <span class="repair-icon">{{ section.settings.icon_svg }}</span>
      {% endif %}
      <h2 class="repair-title">{{ section.settings.heading }}</h2>
    </div>

    <div class="repair-lists">
      {% for block in section.blocks %}
        <ul class="repair-list" {{ block.shopify_attributes }}>
          {% for i in (1..6) %}
            {% assign item = 'item_' | append: i %}
            {% if block.settings[item] != blank %}
              <li>{{ block.settings[item] }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endfor %}
    </div>
  </div>
</section>

<style>
#repair-{{ section.id }}{
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_top }}px {{ section.settings.padding_side }}px {{ section.settings.padding_bottom }}px;
}

#repair-{{ section.id }} .repair-container{
  max-width: {{ section.settings.max_width }}px;
  margin: 0 100px;
}

#repair-{{ section.id }} .repair-header{
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 40px;
}

#repair-{{ section.id }} .repair-icon svg{
  width: 42px;
  height: 42px;
  stroke: {{ section.settings.text_color }};
}

#repair-{{ section.id }} .repair-title{
  font-size: {{ section.settings.heading_size }}px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: {{ section.settings.text_color }};
}

#repair-{{ section.id }} .repair-lists{
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
  gap: 40px;
  justify-items: center;
}

#repair-{{ section.id }} ul{
  list-style: circle;
  padding-left: 20px;
}

#repair-{{ section.id }} li{
  font-size: {{ section.settings.text_size }}px;
  color: {{ section.settings.text_color }};
  margin-bottom: 16px;
}

@media(max-width: 768px){
  #repair-{{ section.id }} .repair-lists{
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Repair Services",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"REPAIR SERVICES"},
    {"type":"checkbox","id":"show_icon","label":"Show Icon","default":true},
    {"type":"textarea","id":"icon_svg","label":"Icon SVG","default":"<svg viewBox='0 0 24 24' fill='none'><circle cx='11' cy='11' r='7' stroke='currentColor' stroke-width='2'/><line x1='16' y1='16' x2='22' y2='22' stroke='currentColor' stroke-width='2'/></svg>"},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#b6bebc"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"range","id":"heading_size","label":"Heading Size","min":16,"max":40,"step":1,"default":24},
    {"type":"range","id":"text_size","label":"Text Size","min":12,"max":22,"step":1,"default":16},
    {"type":"range","id":"columns","label":"Number of Columns","min":1,"max":4,"step":1,"default":3},
    {"type":"range","id":"max_width","label":"Content Width","min":800,"max":1600,"step":50,"default":1400},
    {"type":"range","id":"padding_top","label":"Padding Top","min":20,"max":150,"step":10,"default":80},
    {"type":"range","id":"padding_bottom","label":"Padding Bottom","min":20,"max":150,"step":10,"default":80},
    {"type":"range","id":"padding_side","label":"Side Padding","min":10,"max":80,"step":5,"default":40}
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Service Column",
      "settings": [
        {"type":"text","id":"item_1","label":"Item 1"},
        {"type":"text","id":"item_2","label":"Item 2"},
        {"type":"text","id":"item_3","label":"Item 3"},
        {"type":"text","id":"item_4","label":"Item 4"},
        {"type":"text","id":"item_5","label":"Item 5"},
        {"type":"text","id":"item_6","label":"Item 6"}
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {"name":"Repair Services"}
  ]
}
{% endschema %}
