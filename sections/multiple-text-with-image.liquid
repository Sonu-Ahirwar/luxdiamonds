{% style %}
    #multi-text-image-{{ section.id }}.multi-text-image {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #multi-text-image-{{ section.id }} .multi-text-image__inner {
        max-width: {{ section.settings.page_width }}px;
        margin: 0 auto;
        width: 100%;
    }
    #multi-text-image-{{ section.id }} .multi-text-image__heading {
        font-size: {{ section.settings.heading_size }}px;
        line-height: 1.2;
        color: #395754;
        font-weight: 600;
        letter-spacing: 1px;
        margin-bottom: 12px;
        text-transform: uppercase;
        font-family: "AvenirLTStd";
    }
   
    @media screen and (min-width:576px){
        #multi-text-image-{{ section.id }} .multi-text-image__inner {
            max-width: 540px;
        }
     }
      @media screen and (min-width:768px){
        #multi-text-image-{{ section.id }} .multi-text-image__inner {
            max-width: 720px;
        }
     }
     @media screen and (min-width:992px){
        #multi-text-image-{{ section.id }} .multi-text-image__inner {
            max-width: 960px;
        }
     }
     @media screen and (min-width:1200px){
       #multi-text-image-{{ section.id }} .multi-text-image__inner {
            max-width: 1140px;
        }
     }
     @media screen and (min-width:1400px){
         #multi-text-image-{{ section.id }} .multi-text-image__inner {
            max-width: 1320px;
        }
     }
      @media screen and (max-width:1340px){
        #multi-text-image-{{ section.id }} .multi-text-image__inner{
            padding-inline:15px;
        }
    }
     @media screen and (max-width:991px){
       #multi-text-image-{{ section.id }} .multi-text-image__heading {
        font-size: 20px;
    }
    @media screen and (max-width:749px){
        #multi-text-image-{{ section.id }}.multi-text-image ,
        #multi-text-image-{{ section.id }}.multi-text-image.LabGrownImgTxt_section2{
            padding-top: 0px;
        }
         #multi-text-image-{{ section.id }} .multi-text-image__inner{
            padding:0 15px;
        }
        
    }

{% endstyle %}

<div class="multi-text-image {{ section.settings.custom_class }}" id="multi-text-image-{{ section.id }}">
    <div class="multi-text-image__inner">

        {% if section.settings.section_heading != blank or section.settings.section_description != blank %}
        <div class="multi-text-image__header">
            {% if section.settings.section_heading != blank %}
            <h2 class="multi-text-image__heading">
                {{ section.settings.section_heading }}
            </h2>
            {% endif %}

            {% if section.settings.section_description != blank %}
            <div class="multi-text-image__section-desc">
                {{ section.settings.section_description }}
            </div>
            {% endif %}
        </div>
        {% endif %}

        <div class="multi-text-image-grid_wrapper">
            {% for block in section.blocks %}
            <div class="multi-text-image__grid grid-row-{{ forloop.index }} grid_image_position--{{ block.settings.image_position }}" 
                style="grid-template-columns: {{ block.settings.content_width }}% auto;" 
                {{ block.shopify_attributes }}
            >
                <!-- TEXT -->
                <div class="multi-text-image__content">
                    {% if block.settings.title_url %}
                        <a href="{{ block.settings.title_url }}">
                    {% endif %}
                        {% if block.settings.title != blank %}
                            <h3 class="multi-text-image__title">
                            {{ block.settings.title }}
                            </h3>
                        {% endif %}
                    {% if block.settings.title_url %}
                        </a>
                    {% endif %}

                    {% if block.settings.description != blank %}
                        <div class="multi-text-image__desc">
                        {{ block.settings.description }}
                        </div>
                    {% endif %}
                </div>

                <!-- IMAGE -->
                <div class="multi-text-image__image">
                    {% if block.settings.image != blank %}
                        <div class="multi-text-image__image--inner">
                            <img
                            src="{{ block.settings.image | img_url: 'master' }}"
                            alt="{{ block.settings.image.alt | escape }}"
                            loading="lazy"
                            width=""
                            height=""
                            >
                        </div>
                {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>

        {% if section.settings.show_footer_info %}
            <div class="multi-text-image__footer">
                <div class="multi-text-image__footer-inner">

                {% if section.settings.share_label != blank %}
                    <a
                    href="{{ section.settings.share_link }}"
                    class="footer-info-item"
                    target="_blank"
                    rel="noopener"
                    >
                        <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><g id="Facebook"><path d="M19.02,4.975A9.93,9.93,0,0,0,2.07,12,9.935,9.935,0,0,0,12,21.935a9.98,9.98,0,0,0,3.8-.75,10.189,10.189,0,0,0,3.22-2.16,9.934,9.934,0,0,0,0-14.05Zm-.7,13.34A8.921,8.921,0,0,1,13,20.885v-6.56h1.88a1,1,0,0,0,0-2H13V9.585a1,1,0,0,1,1-1h1.2a1,1,0,0,0,0-2H13.5a2.5,2.5,0,0,0-2.5,2.5v3.24H9.13a1,1,0,1,0,0,2H11v6.56a8.919,8.919,0,1,1,9.26-5.47A9.061,9.061,0,0,1,18.32,18.315Z"></path></g></svg>
                        <span>{{ section.settings.share_label }}</span>
                    </a>
                {% endif %}

                {% if section.settings.tweet_label != blank %}
                    <a
                    href="{{ section.settings.tweet_link }}"
                    class="footer-info-item"
                    target="_blank"
                    rel="noopener"
                    >
                        <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><g id="Twitter"><path d="M19.913,5.322a1.034,1.034,0,0,1,.837,1.629L19.708,8.432c-.064,5.086-1.765,8.539-5.056,10.264A10.917,10.917,0,0,1,9.6,19.835a12.233,12.233,0,0,1-6.2-1.524.76.76,0,0,1-.317-.8.768.768,0,0,1,.63-.6,20.6,20.6,0,0,0,3.745-.886C2,13.5,3.19,7.824,3.71,6.081a1.028,1.028,0,0,1,1.729-.422,9.931,9.931,0,0,0,5.995,2.95A4.188,4.188,0,0,1,12.725,5.3a4.125,4.125,0,0,1,5.7.02ZM4.521,17.794c1.862.872,6.226,1.819,9.667.016,2.955-1.549,4.476-4.732,4.521-9.461a.771.771,0,0,1,.142-.436l1.081-1.538-.041-.053c-.518-.007-1.029-.014-1.55,0a.835.835,0,0,1-.547-.221,3.13,3.13,0,0,0-4.383-.072,3.174,3.174,0,0,0-.935,2.87.646.646,0,0,1-.154.545.591.591,0,0,1-.516.205A10.924,10.924,0,0,1,4.722,6.354c-.67,2.078-1.52,7.094,3.869,9.065a.632.632,0,0,1,.416.538.625.625,0,0,1-.3.6A13.178,13.178,0,0,1,4.521,17.794ZM11.875,8.65h0Zm7.793-.161,0,0Z"></path></g></svg>
                        <span>{{ section.settings.tweet_label }}</span>
                    </a>
                {% endif %}

                </div>
            </div>
        {% endif %}
    </div>
</div>

{% schema %}
{
  "name": "Multiple Text With Image",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading"
    },

    {
      "type": "richtext",
      "id": "section_description",
      "label": "Section Description"
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "min": 24,
      "max": 64,
      "step": 1,
      "default": 40
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80
    },

    {
      "type": "range",
      "id": "page_width",
      "label": "Page Width",
      "min": 900,
      "max": 1800,
      "step": 10,
      "default": 1320
    },
    {
        "type": "header",
        "content": "Footer Information"
    },
    {
        "type": "checkbox",
        "id": "show_footer_info",
        "label": "Show Footer Information",
        "default": true
    },

    {
        "type": "text",
        "id": "share_label",
        "label": "Share Label"
    },
    {
        "type": "url",
        "id": "share_link",
        "label": "Share Link"
    },
    {
        "type": "text",
        "id": "tweet_label",
        "label": "Tweet Label",
    },
    {
        "type": "url",
        "id": "tweet_link",
        "label": "Tweet Link"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "item",
      "name": "Text With Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
            "type": "select",
            "id": "image_position",
            "label": "Image Position",
            "options": [
                { "value": "left", "label": "Left" },
                { "value": "right", "label": "Right" }
            ],
            "default": "right"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "title_url",
          "label": "Title URL"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
            "type": "range",
            "id": "content_width",
            "label": "Content Column Width (%)",
            "min": 30,
            "max": 70,
            "step": 5,
            "default": 50
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Multiple Text With Image",
      "blocks": [{ "type": "item" }]
    }
  ]
}
{% endschema %}
