{% style %}
    .real-life-section {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .real-life-section__inner {
        max-width: {{ section.settings.page_width }}px;
        margin: 0 auto;
    }
    .real-life-section__grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        align-items: stretch;
        gap: 24px;
    }
    .real-life-section__content {
        background: #adb9b7;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height:380px;
        width:100%;
    }
    .real-life-section__content-inner {
        width:100%;
        max-width:60%;
    }
    .real-life-section__title {
        font-size: 24px;
        letter-spacing: 5px;
        margin-bottom: 40px;
    }
    .real-life-section__desc p{
        font-size: 16px;
        line-height:1.5;
        font-family: 'Avenir-med';
        font-weight: 500;
    }
    .real-life-section__image {
        width:100%;
        background-repeat: no-repeat;
        background-position: center;
        background-size: cover;
    }
    .real-life-section__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    @media screen and (max-width:1199px){
        .real-life-section__content-inner {
            max-width: 75%;
        }
        .real-life-section__content {
            min-height: 300px;
        }
    }
    @media screen and (max-width: 991px) {
        .real-life-section__grid {
            grid-template-columns: 1fr;
            gap: 0px;
        }
        .real-life-section__image {
            background-position: 70% 40%;
            background-size: 150%;
            height: 200px;
        }
        .real-life-section__content-inner {
            max-width: 80%;
        }

    }
{% endstyle %}

<div class="real-life-section {{ section.settings.custom_class }}">
  <div class="real-life-section__inner">
    <div class="real-life-section__grid">
      <!-- TEXT PANEL -->
      <div class="real-life-section__content">
        <div class="real-life-section__content-inner">
          {% if section.settings.title != blank %}
            <h2 class="real-life-section__title">
              {{ section.settings.title }}
            </h2>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="real-life-section__desc">
              {{ section.settings.description }}
            </div>
          {% endif %}
        </div>
      </div>

      <!-- IMAGE PANEL -->
      <div class="real-life-section__image" style="background-image:url({{ section.settings.image | image_url: width: 1400 }});">
        {% if section.settings.image != blank %}
          {% comment %} <img
            src="{{ section.settings.image | image_url: width: 1400 }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width=""
            height=""
          > {% endcomment %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Real Life Section",

  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Page Width",
      "min": 800,
      "max": 2800,
      "step": 20,
      "default": 1400
    }
  ],

  "presets": [
    {
      "name": "Real Life Section"
    }
  ]
}
{% endschema %}
