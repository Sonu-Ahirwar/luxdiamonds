{%- comment -%} Grey Screen Prevention — runs BEFORE any JS loads {%- endcomment -%}
<script>
// Shopify Service Worker unregister — grey screen permanent fix
// SW triggers AbortError on this page due to heavy SKU loading
// Unregistering SW only affects this page's navigation transitions
// SEO completely unaffected — SW only handles client-side navigation
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.getRegistrations().then(function(registrations) {
    registrations.forEach(function(reg) {
      // Only unregister if it's Shopify's SW (not custom app SWs)
      if (reg.scope && reg.scope.includes(location.origin)) {
        reg.unregister();
      }
    });
  }).catch(function() {});
}
</script>
<script>
(function() {
  var KEY = 'wdd_load_guard';
  var RELOAD_KEY = 'wdd_reload_count';
  var MAX_RELOADS = 3;
  var TIMEOUT_MS = 12000; // 12s — agar itne mein page ready nahi hua to crash tha

  try {
    // Step 1: Pichli baar crash hua tha? (flag stale hai)
    var prev = sessionStorage.getItem(KEY);
    if (prev) {
      var prevTime = Number(prev);
      var age = Date.now() - prevTime;
      var reloads = Number(sessionStorage.getItem(RELOAD_KEY) || 0);

      // Flag stale hai (pichla load complete nahi hua) aur reload limit nahi aayi
      if (age > 0 && age < 3600000 && reloads < MAX_RELOADS) {
        sessionStorage.setItem(RELOAD_KEY, String(reloads + 1));
        sessionStorage.removeItem(KEY);
        // Grey screen aane se PEHLE reload — user ko kuch nahi dikhta
        location.reload();
        return;
      } else if (reloads >= MAX_RELOADS) {
        // Zyada reload ho gaye — clear karo aur normal load hone do
        sessionStorage.removeItem(KEY);
        sessionStorage.removeItem(RELOAD_KEY);
      }
    }

    // Step 2: Is load ka flag set karo — "main load ho raha hun"
    sessionStorage.setItem(KEY, String(Date.now()));

    // Step 3: Watchdog timer — agar 12s mein success signal nahi aaya
    // to page hang hua hai, quietly reload karo
    var watchdog = setTimeout(function() {
      try {
        var rCount = Number(sessionStorage.getItem(RELOAD_KEY) || 0);
        if (rCount < MAX_RELOADS) {
          sessionStorage.setItem(RELOAD_KEY, String(rCount + 1));
          sessionStorage.removeItem(KEY);
          location.reload();
        }
      } catch(_) {}
    }, TIMEOUT_MS);

    // Step 4: Success signal — JS se wdd_load_success() call karenge
    window.wdd_load_success = function() {
      clearTimeout(watchdog);
      sessionStorage.removeItem(KEY);
      sessionStorage.removeItem(RELOAD_KEY);
    };

    // Step 5: BFCache disable karo — Chrome BFCache + Shopify SW = AbortError grey screen
    // unload listener hone se browser BFCache use nahi karta
    // Ye JS execute hone se PEHLE run hota hai — guaranteed fix
    window.addEventListener('unload', function() {});

    // Step 6: pageshow pe bhi success signal — back navigation ke baad bhi watchdog clear ho
    window.addEventListener('pageshow', function() {
      clearTimeout(watchdog);
      try {
        sessionStorage.removeItem(KEY);
        sessionStorage.removeItem(RELOAD_KEY);
      } catch(_) {}
    });

  } catch(e) {
    // sessionStorage unavailable (private mode etc) — silently ignore
  }
})();
</script>

