<script>
document.addEventListener('DOMContentLoaded', () => {

  const filterBtn = document.querySelector('.wdd-filter-toggle');
  const filterWrap = document.querySelector('.wdd-main-filter');
  const closeBtn = document.querySelector('.wdd-filter-close');

  const filterGroups = document.querySelectorAll('.wdd-filter-group');

  // =========================
  // Filter Popup Toggle
  // =========================

  if (filterBtn && filterWrap) {
    filterBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      filterWrap.classList.toggle('active');
    });
  }

  if (closeBtn && filterWrap) {
    closeBtn.addEventListener('click', () => {
      filterWrap.classList.remove('active');
    });
  }

  // Close outside click
  document.addEventListener('click', (e) => {
    if (
      filterWrap &&
      filterWrap.classList.contains('active') &&
      !filterWrap.contains(e.target) &&
      !filterBtn.contains(e.target)
    ) {
      filterWrap.classList.remove('active');
    }
  });

  // =========================
  // Desktop + Mobile Accordion
  // =========================

  function setupAccordion() {

    // Remove all open first
    filterGroups.forEach((group) => {
      group.removeAttribute('open');
    });

    // =========================
    // DESKTOP
    // =========================

    if (window.innerWidth > 991) {

      // First tab open by default
      if (filterGroups[0]) {
        filterGroups[0].setAttribute('open', '');
      }

      filterGroups.forEach((group) => {

        const summary = group.querySelector('summary');

        if (!summary) return;

        summary.onclick = (e) => {

          e.preventDefault();

          const isOpen = group.hasAttribute('open');

          // Close all
          filterGroups.forEach((other) => {
            other.removeAttribute('open');
          });

          // Open clicked
          if (!isOpen) {
            group.setAttribute('open', '');
          }

        };

      });

    }

    // =========================
    // MOBILE
    // =========================
   else {

  // Open first accordion only initially
  if (![...filterGroups].some(group => group.hasAttribute('open'))) {
    filterGroups[0]?.setAttribute('open', '');
  }

  filterGroups.forEach((group) => {

    const summary = group.querySelector('summary');

    if (!summary) return;

    summary.onclick = (e) => {

      e.preventDefault();

      const isOpen = group.hasAttribute('open');

      // CLOSE CURRENT
      if (isOpen) {

  console.log('isOpen:', isOpen);

  setTimeout(() => {
    group.removeAttribute('open');
  }, 0);

} else {

  console.log('isOpen else:', isOpen);

  // CLOSE OTHERS
  filterGroups.forEach((other) => {
    other.removeAttribute('open');
  });

  // OPEN CURRENT
  group.setAttribute('open', '');

}
    };

  });

}

  }

  setupAccordion();

  window.addEventListener('resize', setupAccordion);

});
</script>
