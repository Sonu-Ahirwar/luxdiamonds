            <option value="manual">Featured</option>
            <option value="title-ascending">Alphabetically, A-Z</option>
            <option value="title-descending">Alphabetically, Z-A</option>
            <option value="price-ascending">Price, low to high</option>
            <option value="price-descending">Price, high to low</option>
          </select>
        </label>
      </div>

      <div class="wdd-active-filters" data-wdd-active-filters></div>
      <template data-wdd-grid-banner-template>
        {% liquid
          assign fallback_banner_file = 'plp_ads_2.643f045fac284ebd8d14.webp'
          assign banner_url = section.settings.insert_image_url | default: '/pages/ring-promise'
        %}
        {% if section.settings.insert_image != blank %}
          {% if banner_url != blank %}<a href="{{ banner_url }}">{% endif %}
          <picture>
            {% if section.settings.insert_image_mobile != blank %}
              <source media="(max-width: 749px)" srcset="{{ section.settings.insert_image_mobile | image_url: width: 900 }}">
            {% endif %}
            <img src="{{ section.settings.insert_image | image_url: width: 1200 }}" alt="{{ section.settings.insert_image_alt | escape }}" loading="lazy">
            <img src="{{ section.settings.insert_image_mobile | image_url: width: 1200 }}" alt="{{ section.settings.insert_image_mobile | escape }}" loading="lazy">
          </picture>
          {% if banner_url != blank %}</a>{% endif %}
        {% else %}
          <a href="{{ banner_url }}">
            <img src="{{ fallback_banner_file | file_url }}" alt="{{ section.settings.insert_image_alt | default: 'Collection banner' | escape }}" loading="lazy">
          </a>
        {% endif %}
      </template>
      <div class="wdd-grid" data-wdd-grid aria-live="polite"></div>
      <div class="wdd-status" data-wdd-status></div>
      <button type="button" class="wdd-load-more" data-wdd-load-more hidden>Load more</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Engagement custom PLP",
  "settings": [
    { "type": "text", "id": "collection_handle", "label": "Fallback collection handle", "default": "engagement-rings" },
    { "type": "text", "id": "heading", "label": "Fallback heading", "default": "Engagement Rings" },
    { "type": "richtext", "id": "description", "label": "Custom description" },
    { "type": "range", "id": "products_per_page", "label": "Products per load", "min": 4, "max": 56, "step": 4, "default": 28 },
    { "type": "image_picker", "id": "insert_image", "label": "Grid banner image" },
    { "type": "image_picker", "id": "insert_image_mobile", "label": "Grid banner mobile image" },
    { "type": "text", "id": "insert_image_alt", "label": "Grid banner alt text", "default": "Collection banner" },
    { "type": "url", "id": "insert_image_url", "label": "Grid banner URL" },
    { "type": "range", "id": "insert_after_position", "label": "Show banner after product number", "min": 1, "max": 40, "step": 1, "default": 10 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "default": 36 }
  ],
  "presets": [{ "name": "Engagement full custom PLP" }]
}
{% endschema %}
