<section class="how-can-we-promise {% if section.settings.full_width_section == true %} full-width {% endif %}" style="background-color: {{ section.settings.bg_color }};">
  <div class="hcp-wrapper">

    <!-- LEFT IMAGE -->
    <div class="hcp-left">
      {% if section.settings.left_image != blank %}
        <img 
          src="{{ section.settings.left_image | img_url: '2000x' }}" 
          alt="{{ section.settings.heading }}"
        >
      {% endif %}
    </div>

    <!-- RIGHT CONTENT -->
    <div class="hcp-right">
        <div class="hcp-right_inner_sec">

      {% if section.settings.heading != blank %}
        <h2 style="color: {{ section.settings.heading_color }};">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      <div class="hcp-points">

        {% for block in section.blocks %}
          <div class="hcp-block">

            {% if block.settings.icon != blank %}
              <div class="hcp-icon">
                <img src="{{ block.settings.icon | img_url: '200x' }}" alt="icon">
              </div>
            {% endif %}

            <p style="color: {{ section.settings.text_color }};">
              {{ block.settings.text }}
            </p>

          </div>
        {% endfor %}

      </div>
      </div>
    </div>

  </div>

  <style>
    .how-can-we-promise {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }

    .hcp-wrapper {
      display: flex;
      align-items: center;
      gap: 20px;
      /* max-width: 1300px; */
      margin: auto;
      /* padding: 0 20px; */
    }

    .hcp-left img {
      width: 100%;
      display: block;
      /* aspect-ratio: 1 / 1.02; */
      object-fit: cover;
    }

    .hcp-left {
      width: 40%;
      position: relative;
    }

    .hcp-right {
      width: 64%;
      background-color: #f6f4f5;
      height: -webkit-fill-available;
      display: flex;
      align-items: center;
    }

    .hcp-right h2 {
      font-size: {{ section.settings.heading_size }}px;
          margin-bottom: 45px;
          letter-spacing: 5px;
          text-transform: uppercase;
          font-weight: 200;
    }
   .how-can-we-promise.full-width .hcp-wrapper .hcp-right h2 {
      font-size: {{ section.settings.heading_size }}px;
    }
    .hcp-block {
        align-items: center;
        display: grid;
        grid-template-columns: 18% 82%;
        margin-bottom: 30px;
    }

    .hcp-icon img {
        
        height: 65px;
        width: 65px;
        object-fit: contain;
    }

    .hcp-block p {
      font-size: {{ section.settings.text_size }}px;
      line-height: 24px;
      {% comment %} max-width: 600px; {% endcomment %}
      {% comment %} line-height: 1.3; {% endcomment %}
      margin: 0px 0px 0px 0px;
      font-weight: 500;
    }

    .hcp-right_inner_sec {
        margin: 50px 40px 50px 70px;
    }

    /* .hcp-icon {
        height: 100%;
        overflow: hidden;
        width: 100%;
    } */

    /* MOBILE */
    @media(max-width: 768px) {
      .hcp-wrapper {
        flex-direction: column;
        text-align: center;
      }

      .hcp-left,
      .hcp-right {
        width: 100%;
      }

      .hcp-icon img {
        margin: 0 auto 10px auto;
      }
    }
  </style>

</section>

{% schema %}
{
  "name": "How Can We Promise",
  "settings": [
    {
      "type": "checkbox",
      "id":"full_width_section",
      "label": "Full Width",
      "default":false
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Side Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How can we promise this?"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#204A4A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#204A4A"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "min": 18,
      "max": 60,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Font Size",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 17
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#F8F8F8"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "promise_block",
      "name": "Promise Point",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Your promise point text goes here."
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "How Can We Promise Section"
    }
  ]
}
{% endschema %}
