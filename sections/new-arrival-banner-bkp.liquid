<style>
    #new-arrival-{{ section.id }} {
      position: relative;
      padding:0px 80px;
      margin-bottom:50px;
    }
    .new-arrival-banner-wrapper {
      position: relative;
      width: 100%;
      max-width: 1615px;
      margin: 0 auto;
    }
    .new-arrival-banner-wrapper::after{
      content:"";
      position:absolute;
      top:0px;
      right:0px;
      width:100%;
      max-width:745px;
      height:100%;
      background: linear-gradient(270deg, #D2BAB9 50%, rgba(234, 201, 200, 0) 100%);
      z-index: 0;
    }
    .new-arrival-banner--image{
      background-image:url({{ section.settings.desktop_image | image_url: width: 2000 }});
      background-repeat: no-repeat;
      background-position: center;
      background-size: contain;
      width: 100%;
      height: 450px;
      margin: 45px auto;
    }
    .new-arrival-banner-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .new-arrival-banner-image.mobile {
        display: none;
    }
    .new-arrival-banner-content {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        color: #fff;
        max-width: 622px;
        padding: 20px;
        z-index: 2;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
    }
    /* Text positions */
    .new-arrival-content-left { left: 0%; text-align: center; }
    .new-arrival-content-center { left: 50%; transform: translate(-50%, -50%); text-align: center; }
    .new-arrival-content-right { right: 0%; text-align: center; }

    .new-arrival-banner-content h2 {
        font-family: "Lora", serif;
        font-weight: 200;
        font-size: 40px;
        line-height: 1.25;
        letter-spacing: 15%;
        margin:0px;
    }
    .new-arrival-banner-content p {
        font-family: 'AvenirLTStd';
        font-size: 14px;
        line-height: 30px;
        letter-spacing: 19%;
        margin: 0px 0px 40px;
    }
    .content_inner_wrap_btn {
        padding: 8px 18px;
        border: 2px solid #395754;
        border-radius:8px;
        text-decoration: none;
        color: #395754;
        font-size: 12px;
        line-height: 16.5px;
        font-weight: 400;
        letter-spacing: 2.75px;
        transition: all .3s ease;
        text-transform: uppercase;
        position: absolute;
        top: 55%;
        right: 11%;
        width: 20%;
        text-align: center;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .content_inner_wrap_btn:hover {
        background: #395754;
        color: #fff;
    }
    @media screen and (max-width:1560px){
      .new-arrival-banner-wrapper {
        max-width: 1285px;
      }
      .new-arrival-banner--image{
        {% comment %} background-size: cover; {% endcomment %}
        width: 80%;
        height: 380px;
      }
      .new-arrival-banner-wrapper::after {
        max-width: 510px;
      }
      .new-arrival-banner-content {
        max-width: 480px;
      }
    }
    @media screen and (max-width:1199px){
      .new-arrival-banner--image {
        height: 290px;
        margin: 20px auto;
      }
      #new-arrival-{{ section.id }} {
      margin-bottom:30px;
      }

      .new-arrival-banner-content {
        max-width: 360px;
      }
      .new-arrival-banner-wrapper::after {
        max-width: 380px;
      }
      .new-arrival-banner-content h2 {
          font-size: 26px;
          letter-spacing: 10%;
      }
      .new-arrival-banner-content p {
        font-size: 11px;
        line-height: 26px;
        letter-spacing: 10%;
        margin: 0px 0px 20px;
      }
      .new-arrival-banner-content a {
        padding: 8px 30px;
        letter-spacing: 1px;
      }
      .content_inner_wrap_btn {
        padding: 6px 10px;
        font-size: 11px;
        letter-spacing: 1.75px;
      }
    }
    @media screen and (max-width:991px){
      #new-arrival-{{ section.id }} {
        padding:0px 12px;
      }
      .new-arrival-banner--image {
        height: 270px;
        margin: 40px auto;
      }
      .content_inner_wrap_btn {
        right: 10%;
        width: 22%;
      }
      
    }
    @media screen and (max-width: 767px) {
      #new-arrival-{{ section.id }} {
        padding:0px;
        margin: 0;
      }
      .new-arrival-banner--image{
        background-image:url({{ section.settings.mobile_image | image_url: width: 800 }});
        background-repeat: no-repeat;
        background-position: center;
        background-size: contain;
        aspect-ratio: 75 / 104;
        height: 550px;
      }
      .new-arrival-banner-wrapper::after{
        display:none;
      }
      .new-arrival-banner-content {
        max-width: 100%;
        padding: 20px 0px;
        justify-content: space-between;
      }
      .new-arrival-banner-content h2 {
        font-size: 34px;
        letter-spacing: 15%;
      }
      .new-arrival-banner-content p {
        font-size: 14px;
      }
      .new-arrival-banner-content a {
        padding: 8px 38px;
        letter-spacing: 2.75px;
      }
      .content_inner_wrap_btn {
        right: 50%;
        width: max-content;
        transform: translate(50%, -90%);
        padding: 6px 38px;
        top: 90%;
        display:none;
      }
    }
    @media screen and (max-width: 480px) {
      .new-arrival-banner--image {
        height: 480px;
      }
    }

</style>

<div class="new-arrival-banner" id="new-arrival-{{ section.id }}">
    <div class="new-arrival-banner-wrapper">
     <a href="{{ section.settings.button_link }}">
        <div class="new-arrival-banner--image"></div>
          {% if section.settings.title != blank or section.settings.subtitle != blank%}
        <div class="new-arrival-banner-content new-arrival-content-{{ section.settings.text_position }}">
            <div class="content_inner_wrap">
              {% if section.settings.title != blank %}
                <h2>{{ section.settings.title }}</h2>
              {% endif %}
              {% if section.settings.subtitle != blank %}
                <p>{{ section.settings.subtitle }}</p>
              {% endif %}
            </div>
        
          </div>
        {% endif %}
        {% if section.settings.button_label != blank %}
            <div class="content_inner_wrap_btn">
              {{ section.settings.button_label }}
            </div>
          {% endif %}
      </a>

    </div>

</div>

{% schema %}
{
  "name": "New Arrival Banner Bkp",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Position",
      "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Arrival Banner Bkp"
    }
  ]
}
{% endschema %}