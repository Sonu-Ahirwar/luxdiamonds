<section class="facet-banner">

  {{ section.settings.heading_font | font_face }}
  {{ section.settings.text_font | font_face }}

  <div class="facet-banner-inner">

    <!-- IMAGE -->
    <picture>
      {% if section.settings.mobile_image != blank %}
        <source media="(max-width: 768px)" 
          srcset="{{ section.settings.mobile_image | image_url: width: 800 }}">
      {% endif %}

      <img 
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="Banner"
        class="facet-banner-img"
      >
    </picture>

    <!-- OVERLAY -->
    <div class="facet-overlay"></div>

    <!-- CONTENT -->
    <div class="facet-content">

      <h1 class="facet-heading">
        {{ section.settings.heading }}
      </h1>

      <p class="facet-subheading">
        {{ section.settings.subheading }}
      </p>

    </div>

  </div>
</section>

<style>
.facet-banner{
position:relative;
width:100%;
overflow:hidden;
}

.facet-banner-inner{
position:relative;
height: 100%;
}

.facet-banner-img{
width:100%;
height:100%;
object-fit:cover;
display:block;
}

/* overlay */
.facet-overlay{
position:absolute;
top:0;
left:0;
width:100%;
height:100%;
background: {{ section.settings.overlay_color }};
opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
}

/* content */
.facet-content {
    position: absolute;
    top: 50%;
    left: 18%;
    transform: translateY(-50%);
    color: #000000;
    z-index: 2;
    width: 100%;
    max-width: fit-content;
}

.facet-heading{
font-family: {{ section.settings.heading_font.family }};
font-size:70px;
letter-spacing:8px;
margin:0;
}

.facet-subheading {
    font-size: 18px;
    letter-spacing: 4px;
    margin-top: 0;
}

/* MOBILE */
@media (max-width:768px){
.facet-content{
left:5%;
right:5%;
}
.facet-heading{
font-size:36px;
letter-spacing:4px;
}
.facet-subheading{
font-size:12px;
letter-spacing:2px;
}

}


</style>

{% schema %}
{
  "name": "Facet Banner",
  "settings": [

    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Banner Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Banner Image"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "FACET"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "YOUR MINNESOTA JEWELRY AND WEDDING BLOG"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },

    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 0
    },

    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "serif"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Subheading Font",
      "default": "sans-serif"
    }

  ],
  "presets": [
    {
      "name": "Facet Banner"
    }
  ]
}
{% endschema %}