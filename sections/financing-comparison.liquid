{% comment %}
  Financing Comparison Table – Fully Customizable Shopify Section
{% endcomment %}

<section id="finance-{{ section.id }}" class="finance-section">
  <div class="finance-container">

    <div class="finance-header">
      {% if section.settings.heading != blank %}
        <h2 class="finance-title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="finance-subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="finance-responsive-table">
      <div class="finance-table">
        <div class="finance-row finance-head">
          <div></div>
          <div>{{ section.settings.col_1 }}</div>
          <div>{{ section.settings.col_2 }}</div>
        </div>

        {% for block in section.blocks %}
          <div class="finance-row" {{ block.shopify_attributes }}>
            <div class="finance-label">{{ block.settings.label }}</div>

            <div class="finance-value">
              {% if block.settings.check_1 %}
                <span class="check-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="#18333C"><path d="M379.33-244 154-469.33 201.67-517l177.66 177.67 378.34-378.34L805.33-670l-426 426Z"></path></svg>
                </span>
              {% else %}
                {{ block.settings.value_1 }}
              {% endif %}
            </div>

            <div class="finance-value">
              {% if block.settings.check_2 %}
                <span class="check-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="#18333C"><path d="M379.33-244 154-469.33 201.67-517l177.66 177.67 378.34-378.34L805.33-670l-426 426Z"></path></svg>
                </span>
              {% else %}
                {{ block.settings.value_2 }}
              {% endif %}
            </div>
          </div>
        {% endfor %}

        <div class="finance-row finance-actions">
          <div></div>
          <div>
            <p class="affirm-as-low-as" style="display: none !important;"
                  data-page-type="product"
                  data-amount="140000">
                </p>
            <a href="javascript:void(0)" class="finance-btn" id="pay-with-affirm">{{ section.settings.btn1_text }}</a>
          </div>
          <div>
            <a href="{{ section.settings.btn2_link }}" class="finance-btn outline">{{ section.settings.btn2_text }}</a>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
<script>
document.getElementById("pay-with-affirm").addEventListener("click", function (e) {
  e.preventDefault();
  document.querySelector(".affirm-modal-trigger").click();
});
</script>

<style>
  #finance-{{ section.id }}{
    padding: {{ section.settings.padding }}px 20px 0px;
    background: {{ section.settings.bg_color }};
  }

  #finance-{{ section.id }} .finance-container{
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #finance-{{ section.id }} .finance-header{
    text-align: center;
    margin-bottom: 40px;
  }

  #finance-{{ section.id }} .finance-title{
    font-size: {{ section.settings.heading_size }}px;
    color: #395754;
    letter-spacing: 3px;
    line-height: 1.2;
    font-weight: 200;
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  #finance-{{ section.id }} .finance-subtitle{
    font-size: 18px;
    letter-spacing: 3px;
    color: #395754;
    margin:0px 0px 8px;
  }

  {% comment %} #finance-{{ section.id }} .finance-table{
    border-top: 4px solid {{ section.settings.header_bg }};
  } {% endcomment %}

  #finance-{{ section.id }} .finance-row{
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border-bottom: 1px solid #dee2e6;
    align-items: center;
  }
  #finance-{{ section.id }} .finance-row.finance-actions{
    border-bottom: 0px solid #dee2e6;
  }

  #finance-{{ section.id }} .finance-head{
    background: {{ section.settings.header_bg }};
    color: #fff;
    font-weight: 200;
  }

  #finance-{{ section.id }} .finance-head div{
    padding: 25px;
    text-align: center;
    font-size: 18px;
    letter-spacing: 2px;
  }

  #finance-{{ section.id }} .finance-label,
  #finance-{{ section.id }} .finance-value{
    padding: 26px 20px;
    font-weight: 500;
    color: #2e5753;
    font-size: 14px;
    letter-spacing: 1px;
    line-height: 21px;
  }
  #finance-{{ section.id }} .finance-label{
    padding-left:50px;
  }

  #finance-{{ section.id }} .finance-value{
    text-align: center;
  }

  #finance-{{ section.id }} .finance-actions div{
    padding: 48px 18px;
    text-align: center;
  }

  #finance-{{ section.id }} .finance-btn{
    display: inline-block;
    padding: 8px 50px;
    color: #305854;
    text-decoration: none;
    font-size: 11px;
    white-space: nowrap;
    border-radius: 8px;
    border: 2px solid #305854;
    font-weight: 500;
    letter-spacing: 2.5px;
    line-height: 21px;
    transition: all 0.6s;
  }
  #finance-{{ section.id }} .finance-btn:hover {
      background: #9cadab;
      border-color: #9cadab;
      color: #fff;
  }

  {% comment %} #finance-{{ section.id }} .finance-btn.outline{
    background: transparent;
  } {% endcomment %}

  #finance-{{ section.id }} .check-icon{
    display: inline-flex;
    /*align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid {{ section.settings.header_bg }};
    color: {{ section.settings.header_bg }};
    font-size: 14px;
    font-weight: 700;*/
  }
  .finance-table {
    background-color: #fafaf9;
  }

  @media screen and (max-width: 991px){
    #finance-{{ section.id }} .finance-label,
    #finance-{{ section.id }} .finance-value{
      padding: 15px;
      font-size: 12px;
      line-height: 20px;
    }
    #finance-{{ section.id }} .finance-label{
      padding-left:10px;
    }
    #finance-{{ section.id }} .finance-row {
      grid-template-columns: 0.6fr 1.2fr 1.2fr;
    }
    .finance-table{
      max-width: 696px;
      width: 100%;
      margin: 0 auto;
    }
  }

  @media screen and (max-width: 749px){
    #finance-{{ section.id }}{
      padding: 60px 15px 0px;
    }
    .finance-responsive-table {
      max-width: 516px;
      width: 100%;
      margin: 0 auto;
      overflow-x: auto;
    }
    .finance-table {
      width: 696px;
    }
    #finance-{{ section.id }} .finance-title{
      font-size: 22px;
    }
    #finance-{{ section.id }} .finance-btn{
      font-size: 10px;
      border-radius: 4px;
      border: 1.6px solid #305854;
    }
  }
</style>

{% schema %}
{
  "name": "Financing Comparison",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"WEDDING DAY DIAMONDS"},
    {"type":"text","id":"subheading","label":"Sub Heading","default":"Financing Options"},
    {"type":"text","id":"col_1","label":"Column 1 Title","default":"AFFIRM"},
    {"type":"text","id":"col_2","label":"Column 2 Title","default":"WELLS FARGO"},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"header_bg","label":"Header Color","default":"#2f554f"},
    {"type":"range","id":"heading_size","label":"Heading Size","min":18,"max":40,"step":1,"default":26},
    {"type":"range","id":"max_width","label":"Content Width","min":900,"max":1600,"step":50,"default":1200},
    {"type":"range","id":"padding","label":"Section Padding","min":40,"max":120,"step":10,"default":80},
    {"type":"text","id":"btn1_text","label":"Button 1 Text","default":"PREQUALIFY NOW"},
    {"type":"url","id":"btn1_link","label":"Button 1 Link"},
    {"type":"text","id":"btn2_text","label":"Button 2 Text","default":"CONTACT US"},
    {"type":"url","id":"btn2_link","label":"Button 2 Link"}
  ],
  "blocks": [
    {
  "type": "row",
  "name": "Comparison Row",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Left Label",
      "default": "Financing Available"
    },
    {
      "type": "checkbox",
      "id": "check_1",
      "label": "Show Check for Column 1 (Affirm)",
      "default": false
    },
    {
      "type": "richtext",
      "id": "value_1",
      "label": "Column 1 Text"
    },
    {
      "type": "checkbox",
      "id": "check_2",
      "label": "Show Check for Column 2 (Wells Fargo)",
      "default": false
    },
    {
      "type": "richtext",
      "id": "value_2",
      "label": "Column 2 Text"
    }
  ]
}

  ],
  "max_blocks": 10,
  "presets": [
    {"name":"Financing Comparison Table"}
  ]
}
{% endschema %}
