<style>
.social-header { 
  display:flex; 
  justify-content:space-between; 
  align-items:center; 
}

.insta-icon svg { 
  cursor:pointer; 
}

/* Slider layout */
.social-slider { 
  position:relative; 
  display:flex; 
  align-items:center; 
}
.social-items-wrapper { 
  overflow:hidden; 
  width:100%; 
}

.social-items { 
  display:flex;
  transition:transform 0.4s ease; 
}

/* Square Item */
.social-item { 
  min-width: 249px; 
  height:249px; 
  position:relative; 
  cursor:pointer; 
}

.media-box {
  position:relative;
  overflow:hidden;
  width:100%;
  height:100%;
}

.media-box img,
.media-box video {
  width:100%;
  height:100%;
  object-fit:cover;
  transition: 1.5s;
}

/* Icons */
.icon-overlay {
  position:absolute;
  top:10px;
  right:10px;
  {% comment %} background:white; {% endcomment %}
  width:26px;
  height:26px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:6px;
  font-size:14px;
  font-weight:700;
  opacity:0.9;
}

.video_icons {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 42px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    opacity: 0.9;
    transform: translate(-50%, -50%);
}

.icon-overlay svg path {
    stroke: #fff;
    fill: #fff;
}

/* Arrows */
.arrow {
  background:white;
  border:none;
  font-size:30px;
  width:40px;
  height:100%;
  cursor:pointer;
  color:#2f4b52;
  font-weight:600;
  opacity:0.8;
}

button.arrow.left-arrow {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 999999;
    background-color: transparent;
    margin-right:6px;
    width: max-content;
    height: max-content;
    transform: translate(0%, -50%);
    transition: 1s;
}

button.arrow.right-arrow {
    position: absolute;
    top: 50%;
    right: 0;
    background-color: transparent;
    margin-left: 6px;
    z-index: 999999;
    width: max-content;
    height: max-content;
    transform: translate(-15%, -50%);
    transition: 1s;
}

button.arrow.left-arrow:hover svg , button.arrow.right-arrow:hover svg {
    transform: scale(1.1);
    transition: 1s;
    background-color: #fff
  }

.page-width.social-header a svg {
    width: 32px;
    height: 32px;
    margin-bottom: 15px;
}

button.arrow svg {
    width: 30px;
    height: 28px;
    background: hsla(0, 0%, 100%, .3);
    border-radius: 50%;
    box-shadow: 0 0 5px 0 rgba(0, 0, 0, .2);
    padding: 6px 6px 6px 8px;
    transition: 1s;
}

.social-items .social-item .media-box:hover img {
    transform: scale(1.2);
    transition: 1.5s;
}
/* Responsive */
@media (max-width: 768px) {
  .social-item { 
    min-width: 200px; 
    height:200px; 
  }
}
@media (max-width: 480px) {
  .social-item { 
    min-width: 160px; 
    height:160px; 
  }
}
</style>


<section class="section section--page-width social-section" id="section-{{ section.id }}">
  <div class="page-width social-header">
    <h2 class="social-title">{{ section.settings.title }}</h2>

    {% if section.settings.instagram_link != blank %}
      <a href="{{ section.settings.instagram_link }}" target="_blank" class="insta-icon">
        <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"></path></svg>
      </a>
    {% endif %}
  </div>

  <div class="page-width social-slider" id="social-slider-{{ section.id }}">

    <button class="arrow left-arrow">
      <svg class="svg-inline--fa fa-chevron-left fa-w-10" aria-hidden="true" data-fa-processed="" data-prefix="fa" data-icon="chevron-left" role="presentation" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M34.52 239.03L228.87 44.69c9.37-9.37 24.57-9.37 33.94 0l22.67 22.67c9.36 9.36 9.37 24.52.04 33.9L131.49 256l154.02 154.75c9.34 9.38 9.32 24.54-.04 33.9l-22.67 22.67c-9.37 9.37-24.57 9.37-33.94 0L34.52 272.97c-9.37-9.37-9.37-24.57 0-33.94z"></path></svg>
    </button>

    <div class="social-items-wrapper">
      <div class="social-items">

        {% for block in section.blocks %}
          <a 
            href="{% if block.settings.type == 'video' %}{{ block.settings.video_url }}{% else %}{{ block.settings.image | img_url: 'master' }}{% endif %}" 
            target="_blank" 
            class="social-item"
          >
            <div class="media-box">

              {% if block.settings.type == 'video' %}
                <img src="{{ block.settings.image | img_url: '600x600' }}" alt="video thumbnail">
                <div class="icon-overlay video_icons">
                  <svg style="color: rgba(255,255,255,1)" class="svg-inline--fa fa-play fa-w-14 sbi_playbtn" aria-label="Play" aria-hidden="true" data-fa-processed="" data-prefix="fa" data-icon="play" role="presentation" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="currentColor" d="M424.4 214.7L72.4 6.6C43.8-10.3 0 6.1 0 47.9V464c0 37.5 40.7 60.1 72.4 41.3l352-208c31.4-18.5 31.5-64.1 0-82.6z"></path></svg>
                </div>

              {% else %}
                <img src="{{ block.settings.image | img_url: '600x600' }}" alt="social image">
                <div class="icon-overlay"><svg class="svg-inline--fa fa-clone fa-w-16 sbi_lightbox_carousel_icon" aria-hidden="true" aria-label="Clone" data-fa-proƒcessed="" data-prefix="far" data-icon="clone" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
	                <path fill="currentColor" d="M464 0H144c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h320c26.51 0 48-21.49 48-48v-48h48c26.51 0 48-21.49 48-48V48c0-26.51-21.49-48-48-48zM362 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h42v224c0 26.51 21.49 48 48 48h224v42a6 6 0 0 1-6 6zm96-96H150a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h308a6 6 0 0 1 6 6v308a6 6 0 0 1-6 6z"></path>
	            </svg></div>
              {% endif %}

            </div>
          </a>
        {% endfor %}

      </div>
    </div>

    <button class="arrow right-arrow">
      <svg class="svg-inline--fa fa-chevron-right fa-w-10" aria-hidden="true" data-fa-processed="" data-prefix="fa" data-icon="chevron-right" role="presentation" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z"></path></svg>
    </button>

  </div>
</section>


<script>
document.addEventListener("DOMContentLoaded", () => {
  const slider = document.querySelector("#social-slider-{{ section.id }} .social-items");
  const itemWidth = document.querySelector("#social-slider-{{ section.id }} .social-item").offsetWidth + 12;
  let position = 0;

  document.querySelector("#social-slider-{{ section.id }} .right-arrow")
    .addEventListener("click", () => {
      if (position > -(slider.scrollWidth - slider.parentElement.offsetWidth)) {
        position -= itemWidth;
        slider.style.transform = `translateX(${position}px)`;
      }
    });

  document.querySelector("#social-slider-{{ section.id }} .left-arrow")
    .addEventListener("click", () => {
      if (position < 0) {
        position += itemWidth;
        slider.style.transform = `translateX(${position}px)`;
      }
    });
});
</script>


{% schema %}
{
  "name": "Social Slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "SOCIAL"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram Page Link"
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Social Item",
      "settings": [
        {
          "type": "select",
          "id": "type",
          "label": "Media Type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (thumbnail)"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (if video type)"
        }
      ]
    }
  ],
  "presets": [
    { "name": "Social Slider" }
  ]
}
{% endschema %}
