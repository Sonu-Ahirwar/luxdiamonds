{%- comment -%}
  Confidence Features Section - Background image + 5 features + Learn More button
{%- endcomment -%}

<section class="confidence-section" id="confidence-{{ section.id }}">
  <div
    class="confidence-container"
    data-bg="{{ section.settings.bg_image | img_url: 'master' }}"
  >
    <div class="confidence-grid">
      <div class="wdd_row">
        {%- for block in section.blocks -%}
          <div class="feature-item">
            {% if block.settings.icon_svg != blank %}
              <div class="feature-icon">
                {{ block.settings.icon_svg }}
              </div>
            {% elsif block.settings.icon_image != blank %}
              <div class="feature-icon">
                <img
                  src="{{ block.settings.icon_image | img_url: 'master' }}"
                  alt="{{ block.settings.title }}"
                  loading="lazy"
                  width="60"
                  height="60"
                >
              </div>
            {% endif %}

            <div class="feature-text">
              {{ block.settings.subtitle }}
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="confidence-right">
        <span class="confidence-heading">
          {{ section.settings.main_heading | default: 'Shop With Confidence' }}
        </span>
        <a
          href="{{ section.settings.button_link | default: '/pages/our-promise' }}"
          class="learn-more-btn"
        >
          {{ section.settings.button_text | default: 'LEARN MORE' }}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .confidence-container {
    background-image: url(https://daywdd.myshopify.com/cdn/shop/files/download.webp?v=1762979509);
    background-size: cover;
    margin-bottom: 50px;
    padding: 30px 0px;
  }
  .confidence-section {
    position: relative;
    overflow: hidden;
    color: white;
  }
  .confidence-grid {
    display: flex;
    align-items: center;
  }
  .wdd_row {
    align-items: center;
    display: flex;
    height: 100%;
    width: 75%;
    justify-content: space-evenly;
  }
  .feature-item {
    display: flex;
    align-items: center;
    flex: 1;
    justify-content: center;
  }
  .feature-icon svg {
    width: 100%;
    height: 100%;
    fill: white;
  }
  .feature-text h3 {
    margin: 0 0 4px 0;
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.2px;
  }
  .confidence-right {
    display: flex;
    width: 25%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-left: 30px;
  }
  .confidence-heading {
    {% comment %} margin: 0 0 20px 0; {% endcomment %}
    font-size: 18px;
    font-weight: 300;
    letter-spacing: 0.2rem;
    text-align: center;
  }
  .learn-more-btn {
    border: 2px solid #fff;
    border-radius: 8px;
    color: #fff;
    letter-spacing: .25em;
    text-align: center;
    width: 68%;
    margin-top: 40px;
    padding: 13px 0;
  }
  .learn-more-btn:hover {
    background: #9cadab !important;
    border-color: #9cadab !important;
  }
  @media screen and (max-width:1280px){
    .confidence-container {
      padding: 35px 0px;
    }
    .feature-text p {
      font-size: 12px;
      line-height: 16px;
      padding-left: 7px;
    }
    .feature-icon img {
      height: 40px;
      width: 40px;
    }
    .confidence-heading {
      font-size: 14px;
    }
    .learn-more-btn {
      border-radius: 6px;
      width: 77%;
    }
  }
  @media screen and (max-width:1199px){
    .confidence-container {
      padding: 37px 0px;
    }
  }

  @media (max-width: 992px) {
    .confidence-grid {
      flex-direction: column;
      text-align: center;
      padding: 0;
    }
    .confidence-right {
      text-align: center;
      width: 100%;
      margin-top: 40px;
      padding: 30px;
    }
    .confidence-container {
      padding: 50px 0px 0px;
      background-image:url(https://cdn.shopify.com/s/files/1/0788/6631/7533/files/feature_bg_mob.png?v=1774016232);
    }
    .feature-text h3 {
      font-size: 0.9rem;
    }
    .feature-text p {
      font-size: 14px;
      text-align: left;
      line-height: 20px;
      padding-left: 22px;
    }
    .feature-icon img {
      width: 50px;
      height: 50px;
    }
    .wdd_row {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0px;
      align-items: flex-start;
      width: 100%;
      margin: auto;
    }
    .learn-more-btn {
      border: 1.5px solid #fff;
      margin-top: 20px;
      padding: 11px 0;
      font-size: 12px;
      width: 55%;
      border-radius: 5px;
    }
    .feature-item {
      flex: unset;
      width: 50%;
      margin: 10px 0px;
    }
    .confidence-heading {
      font-size: 17px;
    }
  }
  @media screen and (max-width:749px){
    .wdd_row {
      flex-direction: column;
      align-items: center;
    }
    .feature-item {
      width: 250px;
      margin: 5px 0px 25px;
      align-items: center;
      justify-content: flex-start;
    }
    .feature-text p {
      font-size: 15px;
      line-height: 19px;
    }
    .confidence-right {
      margin-top: 15px;
      padding: 30px 0px;
    }
    .learn-more-btn {
      font-size: 10px;
      width: 60%;
    }
  }
</style>

{% schema %}
{
  "name": "Shop With Confidence Bkp",
  "class": "confidence-section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Shop With Confidence"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "LEARN MORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG Code",
          "info": "Paste full SVG code (white color recommended)"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image (optional)",
          "info": "Upload image if not using SVG"
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Main Text",
          "default": "<p>FREE LIFETIME WARRANTY</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop With Confidence Bkp",
      "settings": {
        "button_link": "/pages/our-promise"
      }
    }
  ]
}
{% endschema %}
