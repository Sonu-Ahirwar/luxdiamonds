{% style %}
    .perfect-promise {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .perfect-promise__container {
        max-width: {{ section.settings.page_width }}px;
        margin: 0 auto;
    }
    .perfect-promise__box {
        position: relative;
        background-image: url({{ section.settings.bg_image | image_url: width: 2000 }});
        background-size: cover;
        background-position: center top;
        background-repeat: no-repeat;
        text-align: center;
        padding: 70px 0px 65px;
    }
    .perfect-promise__icon img {
        height: 60px;
        width: 70px;
        margin: 0 auto 30px;
    }
    .perfect-promise__title h2{
        font-size: 25px;
        line-height: 1.2;
        font-weight: 300;
        letter-spacing: 5px;
        margin: 0;
        color:#fff;
    }
    .perfect-promise__desc {
        font-family: 'Avenir-oblique';
        font-size: 20px;
        letter-spacing: .5px;
        line-height: 1.3;
        margin: 50px auto 0;
        padding-bottom: 150px;
        width: 50%;
        color:#fff;
    }
    .perfect-promise__cta {
        border: 2px solid #fff;
        border-radius: 8px;
        color: #fff;
        display: inline-block;
        font-size: 16px;
        font-weight: 500;
        letter-spacing: 2.5px;
        min-width: 27%;
        padding: 10px 20px;
        text-decoration: none;
        text-transform: uppercase;
        transition: all .5s ease;
    }
    .perfect-promise__cta:hover {
        background: #9cadab;
        border-color: #9cadab;
        color: #fff;
    }
    @media only screen and (max-width: 1750px) and (min-width: 1200px) {
        .perfect-promise__desc {
            padding-bottom: 120px;
            width: 60%;
        }
    }
    @media screen and (max-width:1400px){
        .perfect-promise__container {
            max-width: 1140px;
            padding-inline:12px;
        }
    }
     @media screen and (max-width:1024px){
        .perfect-promise__container {
            max-width: 960px;
        }
        .perfect-promise__desc {
            width: 70%;
        }
        .perfect-promise__cta {
            letter-spacing: 2px;
            padding: 10px 0px;
        }
    }
    @media screen and (max-width:991px){
        .perfect-promise__container {
            max-width: 720px;
        }
    }
    @media screen and (max-width: 749px) {
        .perfect-promise__title h2 {
            font-size: 18px;
            letter-spacing: 2px;
        }
        .perfect-promise__desc {
            width: 90%;
            font-size: 18px;
            padding-bottom: 120px;
        }
        .perfect-promise__cta {
            min-width: 80%;
        }
    }
{% endstyle %}

<div class="perfect-promise {{ section.settings.custom_class }}">
  <div class="perfect-promise__container">
    <div class="perfect-promise__box">
      <div class="perfect-promise__content">
        {% if section.settings.icon != blank %}
          <div class="perfect-promise__icon">
            <img
              src="{{ section.settings.icon | image_url: width: 200 }}"
              alt="{{ section.settings.icon.alt | escape }}"
              loading="lazy" width="" height=""
            >
          </div>
        {% endif %}

        {% if section.settings.title != blank %}
          <div class="perfect-promise__title">
            {{ section.settings.title }}
          </div>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="perfect-promise__desc">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="perfect-promise__cta">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Perfect Promise Section",
  "disabled_on": {
     "groups": ["header", "footer"] 
    },
  "settings": [
    { "type": "text", "id": "custom_class", "label": "Custom CSS Class" },
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "image_picker", "id": "icon", "label": "Top Icon / Logo" },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    { "type": "url", "id": "button_link", "label": "Button Link" },
    {
      "type": "range",
      "id": "page_width",
      "label": "Banner Width",
      "min": 900,
      "max": 2000,
      "step": 20,
      "default": 1320
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40
    }
  ],

  "presets": [{ "name": "Perfect Promise Section" }]
}
{% endschema %}
